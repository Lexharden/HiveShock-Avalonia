# Usuario de TikTok SIN la @  (tiktok.com/@tu_usuario)
TIKTOK_UNIQUE_ID=tu_usuario
# TIKTOK_ENABLED=1

# Twitch: Client ID de la app HiveShock (el usuario entra con su cuenta; no lo ve).
TWITCH_CLIENT_ID="pca2jj0elk28jha5qpx543vs8g3s7m"
# TWITCH_ENABLED=1
# TWITCH_ACCESS_TOKEN=
# TWITCH_REFRESH_TOKEN=
# TWITCH_USER_LOGIN=
# TWITCH_USER_ID=

# Perfil de juego (opcional; también active-profile.txt o UI)
# CROWDBRIDGE_PROFILE=dusklight
# CROWDBRIDGE_PROFILE=majora-mask
# CROWDBRIDGE_PROFILE=ocarina-of-time

# Si falla "no ttwid cookie": copia la cookie ttwid del navegador
# Chrome -> F12 -> Application -> Cookies -> https://www.tiktok.com -> ttwid
# TIKTOK_TTWID=

# Opcional: cookies extra de sesion (sessionid=...; sid_tt=...)
# TIKTOK_COOKIES=

# Host/puerto del juego (si se omiten, usa los del perfil activo)
GAME_HOST=127.0.0.1
GAME_PORT=43000
CC_PORT=43001
# Eventos bridge←juego (muertes / save; depende del perfil)
EVENT_PORT=43002

# 1 = solo imprime efectos, no los manda al juego
# TIKTOK_DRY_RUN=0

# 1 = no abrir el puerto de pruebas (local → juego)
# DISABLE_CC=0

# 1 = modo pruebas: no conecta a ningún canal, solo puerto local → juego
# BRIDGE_DEV_MODE=0
