<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HiveShock.Avalonia.App"
             xmlns:local="using:HiveShock.Avalonia"
             xmlns:conv="using:HiveShock.Avalonia.Converters"
             RequestedThemeVariant="Default">
    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Themes/Icons.axaml" />
                <ResourceInclude Source="/Themes/Templates.axaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:InvertBoolConverter x:Key="InvertBool" />
            <conv:NullToBoolConverter x:Key="NullToBool" />
            <conv:GiftImageConverter x:Key="GiftImage" />
            <conv:EffectDisplayConverter x:Key="EffectDisplay" />
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <!--
            Los controles de Fluent (CheckBox, ToggleSwitch, Slider, foco, selección de texto…) toman el acento
            de marca en vez del color de acento de Windows, para que la app se vea igual en todos los equipos.
        -->
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Light" Accent="#075BAA" RegionColor="#F3F5F9" ErrorText="#C03E3E" />
                <ColorPaletteResources x:Key="Dark" Accent="#1A6FD1" RegionColor="#0B0E14" ErrorText="#E05656" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="/Themes/Controls.axaml" />
    </Application.Styles>
</Application>
