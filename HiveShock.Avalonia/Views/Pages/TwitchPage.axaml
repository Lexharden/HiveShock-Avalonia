<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="using:HiveShock.Avalonia.Views.Controls"
             xmlns:vm="using:HiveShock.Avalonia.ViewModels"
             x:Class="HiveShock.Avalonia.Views.Pages.TwitchPage"
             x:DataType="vm:TwitchViewModel">
    <!-- Mismo esquema que TikTok: cabecera de una línea con la cuenta, pestañas y maestro/detalle. -->
    <DockPanel>
        <!-- ============================== Cabecera -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <StackPanel DockPanel.Dock="Right" Classes="bar" Spacing="10" ctl:Tour.Key="twitch.account">
                <ToggleSwitch IsChecked="{Binding Studio.TwitchEnabled}" IsEnabled="{Binding Studio.CanEditSetup}"
                              OnContent="Activo en este directo" OffContent="Desactivado"
                              ToolTip.Tip="Si está desactivado, HiveShock no se conecta al chat de Twitch." />
                <Border Classes="pill ok" Padding="10,4" IsVisible="{Binding Studio.TwitchHasAccount}">
                    <TextBlock FontSize="12" Text="{Binding Studio.TwitchLogin, StringFormat=@{0}}" />
                </Border>
                <Button Classes="primary" Margin="0"
                        Command="{Binding Studio.ConnectTwitchCommand}"
                        IsEnabled="{Binding Studio.CanTwitchConnect}"
                        IsVisible="{Binding !Studio.TwitchHasAccount}">
                    <StackPanel Classes="btnContent">
                        <ctl:Icon Data="{StaticResource Icon.Twitch}" />
                        <TextBlock Text="Entrar con Twitch" />
                    </StackPanel>
                </Button>
                <Button Classes="secondary" Margin="0" Content="Salir"
                        Command="{Binding Studio.DisconnectTwitchCommand}"
                        IsEnabled="{Binding Studio.CanEditSetup}"
                        IsVisible="{Binding Studio.TwitchHasAccount}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Border Width="34" Height="34" CornerRadius="8" Background="#269146FF">
                    <ctl:Icon Data="{StaticResource Icon.Twitch}" Size="18" Foreground="#A970FF" />
                </Border>
                <StackPanel VerticalAlignment="Center" Spacing="1">
                    <TextBlock Classes="h1" FontSize="18" Text="Twitch" />
                    <TextBlock Text="{Binding Studio.TwitchPortStatus}" FontSize="12"
                               Foreground="{DynamicResource MutedBrush}" />
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <TabControl>
            <!-- ============================== Chat -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Classes="tabHeader">
                        <ctl:Icon Data="{StaticResource Icon.Chat}" />
                        <TextBlock Text="Chat" />
                    </StackPanel>
                </TabItem.Header>
                <DockPanel Margin="0,12,0,0">
                    <Border DockPanel.Dock="Top" Classes="section" Padding="14,10" Margin="0,0,0,12">
                        <WrapPanel ItemSpacing="20" LineSpacing="8" VerticalAlignment="Center">
                            <ToggleSwitch IsChecked="{Binding Events.TwitchChatEnabled}"
                                          OnContent="Comandos activados" OffContent="Comandos desactivados" />
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Classes="fieldLabel" Margin="0" Text="Prefijo" VerticalAlignment="Center" />
                                <TextBox Text="{Binding Events.TwitchChatPrefix}" Width="56" HorizontalContentAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                                        ToolTip.Tip="Segundos que cada espectador espera entre dos comandos.">
                                <TextBlock Classes="fieldLabel" Margin="0" Text="Espera por espectador" VerticalAlignment="Center" />
                                <TextBox Text="{Binding Events.TwitchChatCooldownText}" Width="56" HorizontalContentAlignment="Center" />
                                <TextBlock Classes="caption" Text="s" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                                        ToolTip.Tip="Segundos mínimos entre dos comandos de cualquier espectador.">
                                <TextBlock Classes="fieldLabel" Margin="0" Text="Espera entre todos" VerticalAlignment="Center" />
                                <TextBox Text="{Binding Events.TwitchChatGlobalGapText}" Width="56" HorizontalContentAlignment="Center" />
                                <TextBlock Classes="caption" Text="s" VerticalAlignment="Center" />
                            </StackPanel>
                        </WrapPanel>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280" MinWidth="220" MaxWidth="520" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" MinWidth="340" />
                        </Grid.ColumnDefinitions>
                        <Border Classes="panel">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Classes="paneHeader">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Classes="bar" Spacing="2">
                                            <Button Classes="icon" Command="{Binding Events.AddTwitchCommandCommand}" ToolTip.Tip="Añadir comando">
                                                <ctl:Icon Data="{StaticResource Icon.Plus}" />
                                            </Button>
                                            <Button Classes="icon" Command="{Binding Events.RemoveTwitchCommandCommand}" ToolTip.Tip="Eliminar el comando seleccionado (Supr)">
                                                <ctl:Icon Data="{StaticResource Icon.Trash}" />
                                            </Button>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Classes="h2" Text="Comandos" />
                                            <Border Classes="pill">
                                                <TextBlock Text="{Binding Events.TwitchChatCommands.Count}" />
                                            </Border>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <Border DockPanel.Dock="Bottom" Classes="paneFooter">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Classes="primary" Margin="8,0,0,0" Command="{Binding Events.SaveCommand}">
                                            <StackPanel Classes="btnContent">
                                                <ctl:Icon Data="{StaticResource Icon.Save}" />
                                                <TextBlock Text="Guardar" />
                                            </StackPanel>
                                        </Button>
                                        <ctl:SaveStatusChip DataContext="{Binding Events.SaveStatus}" />
                                    </DockPanel>
                                </Border>
                                <Panel>
                                    <ListBox Classes="plain" ItemsSource="{Binding Events.TwitchChatCommands}"
                                             SelectedItem="{Binding Events.SelectedTwitchCommand}"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             ctl:ListGestures.DeleteCommand="{Binding Events.RemoveTwitchCommandCommand}"
                                             ctl:ListGestures.Reorder="True">
                                            <ListBox.ContextFlyout>
                                                <MenuFlyout>
                                                    <MenuItem Header="Eliminar" Command="{Binding Events.RemoveTwitchCommandCommand}">
                                                        <MenuItem.Icon>
                                                            <ctl:Icon Data="{StaticResource Icon.Trash}" Size="16" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                </MenuFlyout>
                                            </ListBox.ContextFlyout>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ChatCommandRowViewModel">
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Right" Classes="pill gold" Margin="8,0,0,0"
                                                            IsVisible="{Binding HasExtraSteps}">
                                                        <TextBlock Text="{Binding StepSummary}" />
                                                    </Border>
                                                    <StackPanel Spacing="2">
                                                        <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                                            <Run Text="{Binding $parent[UserControl].((vm:TwitchViewModel)DataContext).Events.TwitchChatPrefix}"
                                                                 Foreground="{DynamicResource FaintBrush}" />
                                                            <Run Text="{Binding Word}" />
                                                        </TextBlock>
                                                        <TextBlock FontSize="12" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis">
                                                            <TextBlock.Text>
                                                                <MultiBinding Converter="{StaticResource EffectDisplay}">
                                                                    <Binding Path="Effect" />
                                                                    <Binding Path="$parent[UserControl].((vm:TwitchViewModel)DataContext).Events.EffectsWithNone" />
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <StackPanel Classes="empty" IsVisible="{Binding !Events.TwitchChatCommands.Count}">
                                        <ctl:Icon Data="{StaticResource Icon.Chat}" />
                                        <TextBlock Classes="h2" Text="Sin comandos" />
                                        <TextBlock Classes="caption" Text="Crea uno con + y elige qué hace en el juego." />
                                    </StackPanel>
                                </Panel>
                            </DockPanel>
                        </Border>

                        <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

                        <Border Grid.Column="2" Classes="panel" Container.Name="editor" Container.Sizing="Width">
                            <Panel>
                                <StackPanel Classes="empty" IsVisible="{Binding Events.SelectedTwitchCommand, Converter={x:Static ObjectConverters.IsNull}}">
                                    <ctl:Icon Data="{StaticResource Icon.Chat}" />
                                    <TextBlock Classes="h2" Text="Elige un comando" />
                                    <TextBlock Classes="caption" Text="Selecciona un comando de la lista para editarlo." />
                                </StackPanel>
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              IsVisible="{Binding Events.SelectedTwitchCommand, Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <StackPanel Margin="20,18,20,24" MaxWidth="720" DataContext="{Binding Events.SelectedTwitchCommand}"
                                                x:DataType="vm:ChatCommandRowViewModel">
                                        <UniformGrid Classes="formRow">
                                            <StackPanel Grid.Column="0" Classes="field">
                                                <TextBlock Classes="fieldLabel" Text="Palabra que escribe el espectador" />
                                                <TextBox Text="{Binding Word}" PlaceholderText="p. ej. saltar" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Classes="field">
                                                <TextBlock Classes="fieldLabel" Text="Efecto" />
                                                <ComboBox HorizontalAlignment="Stretch"
                                                          ItemsSource="{Binding $parent[UserControl].((vm:TwitchViewModel)DataContext).Events.EffectsWithNone}"
                                                          SelectedValue="{Binding Effect}"
                                                          SelectedValueBinding="{Binding Id}"
                                                          DisplayMemberBinding="{Binding Display}" />
                                            </StackPanel>
                                        </UniformGrid>
                                        <ctl:StepListEditor DataContext="{Binding Steps}" Margin="0,6,0,0" />
                                    </StackPanel>
                                </ScrollViewer>
                            </Panel>
                        </Border>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- ============================== Bits -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Classes="tabHeader">
                        <ctl:Icon Data="{StaticResource Icon.Gem}" />
                        <TextBlock Text="Bits" />
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" MinWidth="220" MaxWidth="520" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" MinWidth="340" />
                    </Grid.ColumnDefinitions>
                    <Border Classes="panel">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Classes="paneHeader">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Classes="bar" Spacing="2">
                                        <Button Classes="icon" Command="{Binding Events.AddBitsRuleCommand}" ToolTip.Tip="Añadir regla de bits">
                                            <ctl:Icon Data="{StaticResource Icon.Plus}" />
                                        </Button>
                                        <Button Classes="icon" Command="{Binding Events.RemoveBitsRuleCommand}" ToolTip.Tip="Eliminar la regla seleccionada (Supr)">
                                            <ctl:Icon Data="{StaticResource Icon.Trash}" />
                                        </Button>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Classes="h2" Text="Reglas de bits" />
                                        <Border Classes="pill">
                                            <TextBlock Text="{Binding Events.TwitchBits.Count}" />
                                        </Border>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border DockPanel.Dock="Bottom" Classes="paneFooter">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Classes="primary" Margin="8,0,0,0" Command="{Binding Events.SaveCommand}">
                                        <StackPanel Classes="btnContent">
                                            <ctl:Icon Data="{StaticResource Icon.Save}" />
                                            <TextBlock Text="Guardar" />
                                        </StackPanel>
                                    </Button>
                                    <ctl:SaveStatusChip DataContext="{Binding Events.SaveStatus}" />
                                </DockPanel>
                            </Border>
                            <Panel>
                                <ListBox Classes="plain" ItemsSource="{Binding Events.TwitchBits}"
                                         SelectedItem="{Binding Events.SelectedBitsRule}"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ctl:ListGestures.DeleteCommand="{Binding Events.RemoveBitsRuleCommand}">
                                        <ListBox.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuItem Header="Eliminar" Command="{Binding Events.RemoveBitsRuleCommand}">
                                                    <MenuItem.Icon>
                                                        <ctl:Icon Data="{StaticResource Icon.Trash}" Size="16" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                            </MenuFlyout>
                                        </ListBox.ContextFlyout>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:BitsRowViewModel">
                                            <DockPanel>
                                                <Border DockPanel.Dock="Right" Classes="pill gold" Margin="8,0,0,0"
                                                        IsVisible="{Binding HasExtraSteps}">
                                                    <TextBlock Text="{Binding StepSummary}" />
                                                </Border>
                                                <StackPanel Spacing="2">
                                                    <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                                        <Run Text="Desde " Foreground="{DynamicResource FaintBrush}" />
                                                        <Run Text="{Binding MinText}" />
                                                        <Run Text=" bits" Foreground="{DynamicResource FaintBrush}" />
                                                    </TextBlock>
                                                    <TextBlock FontSize="12" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis">
                                                        <TextBlock.Text>
                                                            <MultiBinding Converter="{StaticResource EffectDisplay}">
                                                                <Binding Path="Effect" />
                                                                <Binding Path="$parent[UserControl].((vm:TwitchViewModel)DataContext).Events.EffectsWithNone" />
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel Classes="empty" IsVisible="{Binding !Events.TwitchBits.Count}">
                                    <ctl:Icon Data="{StaticResource Icon.Gem}" />
                                    <TextBlock Classes="h2" Text="Sin reglas de bits" />
                                    <TextBlock Classes="caption" Text="Elige qué pasa en el juego a partir de cierta cantidad de bits." />
                                </StackPanel>
                            </Panel>
                        </DockPanel>
                    </Border>

                    <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

                    <Border Grid.Column="2" Classes="panel" Container.Name="editor" Container.Sizing="Width">
                        <Panel>
                            <StackPanel Classes="empty" IsVisible="{Binding Events.SelectedBitsRule, Converter={x:Static ObjectConverters.IsNull}}">
                                <ctl:Icon Data="{StaticResource Icon.Gem}" />
                                <TextBlock Classes="h2" Text="Elige una regla" />
                                <TextBlock Classes="caption" Text="Selecciona una regla de la lista para editarla." />
                            </StackPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          IsVisible="{Binding Events.SelectedBitsRule, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <StackPanel Margin="20,18,20,24" MaxWidth="720" DataContext="{Binding Events.SelectedBitsRule}"
                                            x:DataType="vm:BitsRowViewModel">
                                    <Grid ColumnDefinitions="Auto,16,*">
                                        <StackPanel Grid.Column="0" Classes="field">
                                            <TextBlock Classes="fieldLabel" Text="A partir de (bits)" />
                                            <TextBox Text="{Binding MinText}" Width="140" PlaceholderText="mín. bits" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Classes="field">
                                            <TextBlock Classes="fieldLabel" Text="Efecto" />
                                            <ComboBox HorizontalAlignment="Stretch"
                                                      ItemsSource="{Binding $parent[UserControl].((vm:TwitchViewModel)DataContext).Events.EffectsWithNone}"
                                                      SelectedValue="{Binding Effect}"
                                                      SelectedValueBinding="{Binding Id}"
                                                      DisplayMemberBinding="{Binding Display}" />
                                        </StackPanel>
                                    </Grid>
                                    <ctl:StepListEditor DataContext="{Binding Steps}" Margin="0,6,0,0" />
                                </StackPanel>
                            </ScrollViewer>
                        </Panel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ============================== Seguidores -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Classes="tabHeader">
                        <ctl:Icon Data="{StaticResource Icon.UserPlus}" />
                        <TextBlock Text="Seguidores" />
                    </StackPanel>
                </TabItem.Header>
                <DockPanel Margin="0,12,0,0">
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <Button DockPanel.Dock="Right" Classes="primary" Margin="0" Command="{Binding Events.SaveCommand}">
                            <StackPanel Classes="btnContent">
                                <ctl:Icon Data="{StaticResource Icon.Save}" />
                                <TextBlock Text="Guardar" />
                            </StackPanel>
                        </Button>
                        <ctl:SaveStatusChip DataContext="{Binding Events.SaveStatus}" HorizontalAlignment="Left" />
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Border Classes="section" VerticalAlignment="Top" MaxWidth="560" HorizontalAlignment="Left">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,14">
                                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource AccentSubtleBrush}">
                                        <ctl:Icon Data="{StaticResource Icon.UserPlus}" Size="17" Foreground="{DynamicResource AccentTextBrush}" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Classes="h2" Text="Nuevo seguidor" />
                                        <TextBlock Classes="caption" Text="Cuando alguien te sigue en Twitch" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Classes="field">
                                    <TextBlock Classes="fieldLabel" Text="Efecto" />
                                    <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Events.EffectsWithNone}"
                                              SelectedValue="{Binding Events.TwitchFollowEffect}"
                                              SelectedValueBinding="{Binding Id}"
                                              DisplayMemberBinding="{Binding Display}" />
                                </StackPanel>
                                <CheckBox Content="Solo la primera vez que sigue" Margin="0,0,0,4"
                                          ToolTip.Tip="Evita el spam de seguir y dejar de seguir."
                                          IsChecked="{Binding Events.FollowOncePerUser}" />
                                <Button Classes="ghost" Padding="8,4" MinHeight="28" Margin="0,0,0,10" HorizontalAlignment="Left"
                                        Content="Olvidar seguidores" Command="{Binding Events.ClearFollowHistoryCommand}" />
                                <ctl:StepListEditor DataContext="{Binding Events.TwitchFollowSteps}" />
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
