<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HiveShock.Avalonia.ViewModels"
             xmlns:ctl="using:HiveShock.Avalonia.Views.Controls"
             x:Class="HiveShock.Avalonia.Views.Pages.UpdatesPage"
             x:DataType="vm:UpdatesViewModel">
    <DockPanel MaxWidth="1080" HorizontalAlignment="Stretch">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16" Spacing="2">
            <TextBlock Classes="h1" Text="Actualizaciones" />
            <TextBlock Classes="caption"
                       Text="HiveShock te avisa cuando hay una versión nueva y solo la instala cuando tú lo decides. Tus perfiles, regalos, metas y credenciales no se tocan." />
        </StackPanel>

        <!-- Estado + ajustes -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,16,360" Margin="0,0,0,16">
            <Border Grid.Column="0" Classes="section">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="48" Height="48" CornerRadius="12" Margin="0,0,16,0"
                            VerticalAlignment="Top" Background="{DynamicResource GoldSubtleBrush}">
                        <ctl:Icon Data="{StaticResource Icon.Download}" Size="24" Foreground="{DynamicResource GoldTextBrush}" />
                    </Border>
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding CurrentVersionText}" Classes="caption" />
                        <TextBlock Text="{Binding StatusText}" Classes="h2" FontSize="17" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding StatusDetail}" Classes="caption"
                                   IsVisible="{Binding StatusDetail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" Height="6"
                                     IsVisible="{Binding ShowProgress}" Margin="0,4,0,0" />
                        <StackPanel Classes="bar" Spacing="8" Margin="0,8,0,0">
                            <Button Classes="primary" Margin="0" Command="{Binding InstallLatestCommand}"
                                    IsVisible="{Binding HasUpdate}" IsEnabled="{Binding !IsBusy}">
                                <StackPanel Classes="btnContent">
                                    <ctl:Icon Data="{StaticResource Icon.Download}" />
                                    <TextBlock Text="{Binding InstallLatestText}" />
                                </StackPanel>
                            </Button>
                            <Button Classes="secondary" Margin="0" Command="{Binding CheckNowCommand}"
                                    IsEnabled="{Binding !IsBusy}">
                                <StackPanel Classes="btnContent">
                                    <ctl:Icon Data="{StaticResource Icon.Refresh}" />
                                    <TextBlock Text="Buscar actualizaciones" />
                                </StackPanel>
                            </Button>
                            <Button Classes="ghost" Content="Omitir esta versión"
                                    Command="{Binding SkipLatestCommand}" IsVisible="{Binding HasUpdate}" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Classes="section">
                <StackPanel Spacing="10">
                    <TextBlock Classes="h2" Text="Ajustes" />
                    <CheckBox IsChecked="{Binding CheckOnStart}"
                              Content="Buscar al abrir y cada pocas horas" />
                    <CheckBox IsChecked="{Binding IncludePrereleases}"
                              Content="Recibir versiones beta (antes que nadie, pueden tener fallos)" />
                    <TextBlock Classes="caption"
                               Text="No se descarga nada por su cuenta. Al instalar, la versión se verifica y, si no arranca bien, se restaura la anterior." />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Versiones -->
        <Border Classes="panel">
            <DockPanel>
                <Border DockPanel.Dock="Top" Classes="paneHeader">
                    <TextBlock Classes="h2" Text="Versiones publicadas" VerticalAlignment="Center" />
                </Border>
                <Panel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ReleaseRow">
                                    <Border Padding="16,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Top"
                                                    Classes="primary" Classes.secondary="{Binding !IsNewer}"
                                                    Content="{Binding ActionText}"
                                                    IsVisible="{Binding CanInstall}"
                                                    CommandParameter="{Binding}"
                                                    Command="{Binding $parent[UserControl].((vm:UpdatesViewModel)DataContext).InstallRowCommand}" />
                                            <StackPanel Spacing="4">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding Version}" FontWeight="SemiBold" FontSize="15" />
                                                    <Border Classes="pill gold"
                                                            IsVisible="{Binding Badge, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                        <TextBlock Text="{Binding Badge}" />
                                                    </Border>
                                                    <Border Classes="pill" IsVisible="{Binding IsPrerelease}">
                                                        <TextBlock Text="beta" />
                                                    </Border>
                                                    <TextBlock Text="{Binding DateText}" Classes="caption" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Unavailable}" Classes="caption" IsVisible="{Binding IsUnavailable}" />
                                                <TextBlock Text="{Binding Notes}" Classes="caption" MaxHeight="120"
                                                           TextTrimming="CharacterEllipsis" IsVisible="{Binding HasNotes}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <StackPanel Classes="empty" IsVisible="{Binding !HasRows}">
                        <ctl:Icon Data="{StaticResource Icon.Download}" />
                        <TextBlock Classes="h2" Text="Todavía no hay lista" />
                        <TextBlock Classes="caption" Text="Pulsa «Buscar actualizaciones» para ver las versiones publicadas." />
                    </StackPanel>
                </Panel>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
