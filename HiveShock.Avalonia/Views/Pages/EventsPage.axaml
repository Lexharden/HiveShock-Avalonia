<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HiveShock.Avalonia.ViewModels"
             x:Class="HiveShock.Avalonia.Views.Pages.EventsPage"
             x:DataType="vm:EventsViewModel">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Classes="pageTitle" Text="Eventos" />
            <TextBlock Classes="pageLead"
                       Text="Efectos que no son un regalo. El chat vale en todos los canales; lo demás está en la sección de cada uno." />

            <Border Classes="card" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Classes="sectionTitle" Text="TODOS LOS CANALES — CHAT" />
                    <TextBlock Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,8"
                               TextWrapping="Wrap"
                               Text="Si alguien escribe !salto en TikTok o en Twitch, el juego hace lo mismo." />
                    <CheckBox Content="Permitir palabras en el chat" IsChecked="{Binding ChatEnabled}" />
                    <DockPanel Margin="0,10,0,12">
                        <TextBlock Classes="fieldLabel" Text="Empieza por" Width="90" VerticalAlignment="Center" />
                        <TextBox Text="{Binding ChatPrefix}" Width="64" HorizontalAlignment="Left" />
                    </DockPanel>
                    <WrapPanel>
                        <Button Classes="secondary" Content="Añadir" Command="{Binding AddCommandCommand}" />
                        <Button Classes="secondary" Content="Quitar" Command="{Binding RemoveCommandCommand}" />
                    </WrapPanel>
                    <ListBox ItemsSource="{Binding ChatCommands}" SelectedItem="{Binding SelectedCommand}"
                             MaxHeight="220" Margin="0,8,0,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ChatCommandRowViewModel">
                                <DockPanel>
                                    <ComboBox DockPanel.Dock="Right" Width="220" Margin="8,0,0,0"
                                              ItemsSource="{Binding $parent[UserControl].((vm:EventsViewModel)DataContext).EffectsWithNone}"
                                              SelectedValue="{Binding Effect}"
                                              SelectedValueBinding="{Binding Id}"
                                              DisplayMemberBinding="{Binding Display}" />
                                    <TextBox Text="{Binding Word}" PlaceholderText="palabra" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <Border Classes="card" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Classes="sectionTitle" Text="TODOS LOS CANALES — NUEVOS SEGUIDORES" />
                    <TextBlock Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,8"
                               TextWrapping="Wrap"
                               Text="TikTok y Twitch usan el mismo efecto." />
                    <TextBlock Classes="fieldLabel" Text="Qué hace" />
                    <ComboBox ItemsSource="{Binding EffectsWithNone}"
                              SelectedValue="{Binding FollowEffect}"
                              SelectedValueBinding="{Binding Id}"
                              DisplayMemberBinding="{Binding Display}" />
                </StackPanel>
            </Border>

            <Border Classes="card" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Classes="sectionTitle" Text="TIKTOK — LIKES" />
                    <TextBlock Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,8"
                               TextWrapping="Wrap"
                               Text="Solo TikTok. 0 = apagado. Ejemplo: 50 hace el efecto cada 50 likes." />
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock Classes="fieldLabel" Text="Cada cuántos likes" Width="140"
                                   VerticalAlignment="Center" />
                        <TextBox Text="{Binding LikesEveryText}" Width="80" HorizontalAlignment="Left" />
                    </DockPanel>
                    <TextBlock Classes="fieldLabel" Text="Qué hace" />
                    <ComboBox ItemsSource="{Binding EffectsWithNone}"
                              SelectedValue="{Binding LikesEffect}"
                              SelectedValueBinding="{Binding Id}"
                              DisplayMemberBinding="{Binding Display}" />
                </StackPanel>
            </Border>

            <Border Classes="card" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Classes="sectionTitle" Text="TIKTOK — CUANDO COMPARTEN EL LIVE" />
                    <TextBlock Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,8"
                               TextWrapping="Wrap"
                               Text="Solo TikTok. En Twitch no hay equivalente." />
                    <TextBlock Classes="fieldLabel" Text="Qué hace" />
                    <ComboBox ItemsSource="{Binding EffectsWithNone}"
                              SelectedValue="{Binding ShareEffect}"
                              SelectedValueBinding="{Binding Id}"
                              DisplayMemberBinding="{Binding Display}" />
                </StackPanel>
            </Border>

            <Border Classes="card" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Classes="sectionTitle" Text="TWITCH — BITS Y PUNTOS" />
                    <TextBlock Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap"
                               Text="Aún no. Aquí irán bits y recompensas del canal, separados de los regalos de TikTok. El chat de Twitch ya usa la lista de arriba." />
                </StackPanel>
            </Border>

            <Button Classes="primary" Content="Guardar" Command="{Binding SaveCommand}"
                    HorizontalAlignment="Left" MinWidth="140" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
