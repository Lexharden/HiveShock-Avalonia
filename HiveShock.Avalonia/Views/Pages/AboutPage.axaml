9921A3.9996 3.9996 0 0 1 8 12.0077</StreamGeometry>
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="Button.member">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardAltBrush}" />
        </Style>
        <Style Selector="Border.member">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardAltBrush}" />
        </Style>
        <Style Selector="Button.social">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,4,8,8" />
        </Style>
        <Style Selector="Button.social PathIcon">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.social:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Opacity" Value="0.88" />
        </Style>
        <Style Selector="Button.discord">
            <Setter Property="Background" Value="#5865F2" />
        </Style>
        <Style Selector="Button.discord:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#5865F2" />
        </Style>
        <Style Selector="Button.youtube">
            <Setter Property="Background" Value="#FF0000" />
        </Style>
        <Style Selector="Button.youtube:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#FF0000" />
        </Style>
        <Style Selector="Button.instagram">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,100%" EndPoint="100%,0%">
                    <GradientStop Offset="0" Color="#F58529" />
                    <GradientStop Offset="0.5" Color="#DD2A7B" />
                    <GradientStop Offset="1" Color="#8134AF" />
                </LinearGradientBrush>
            </Setter>
        </Style>
        <Style Selector="Button.instagram:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,100%" EndPoint="100%,0%">
                    <GradientStop Offset="0" Color="#F58529" />
                    <GradientStop Offset="0.5" Color="#DD2A7B" />
                    <GradientStop Offset="1" Color="#8134AF" />
                </LinearGradientBrush>
            </Setter>
        </Style>
    </UserControl.Styles>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Classes="pageTitle" Text="Acerca de" />
            <TextBlock Classes="pageLead"
                       Text="Quién hace HiveShock, qué versión tienes, dónde encontrar la comunidad y cómo apoyar el proyecto." />

            <Border Classes="card" Margin="0,0,0,14">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14" Spacing="16">
                        <Border Width="88" Height="88" CornerRadius="16" ClipToBounds="True"
                                Background="{DynamicResource CardAltBrush}"
                                BorderBrush="{DynamicResource BrandGoldBrush}" BorderThickness="2">
                            <Image Source="{DynamicResource BrandLogo}" Stretch="Uniform" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontSize="26" FontWeight="SemiBold" Text="{Binding AppName}" />
                            <TextBlock Margin="0,4,0,0" FontSize="14" Foreground="{DynamicResource MutedBrush}"
                                       Text="{Binding VersionLabel}" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Classes="helpBody"
                               Text="HiveShock conecta tu live con el juego: chat, regalos y el resto de eventos se convierten en efectos dentro de la partida." />
                    <TextBlock Classes="helpBody"
                               Text="Cada juego es un perfil con sus propios efectos." />
                </StackPanel>
            </Border>

            <Border Classes="card" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Classes="sectionTitle" Text="COMUNIDAD" />
                    <TextBlock Classes="helpBody"
                               Text="Únete al Discord para pedir ayuda, compartir tus perfiles y enterarte antes de las novedades. En YouTube hay tutoriales y demostraciones." />
                    <WrapPanel>
                        <Button Classes="social discord" Command="{Binding OpenDiscordCommand}"
                                ToolTip.Tip="{Binding DiscordUrl}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{StaticResource DiscordIcon}" />
                                <TextBlock Text="Unirme al Discord" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="social youtube" Command="{Binding OpenYouTubeCommand}"
                                ToolTip.Tip="{Binding YouTubeUrl}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{StaticResource YouTubeIcon}" />
                                <TextBlock Text="Canal de YouTube" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Classes="card" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Classes="sectionTitle" Text="QUIÉN LO HACE" />
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding Developer}" />
                    <TextBlock Margin="0,6,0,12" Classes="helpBody"
                               Text="Hola, soy Yafel. Diseño y programo HiveShock. Si quieres novedades o más proyectos, pásate por la web o sígueme en Instagram." />
                    <WrapPanel>
                        <Button Classes="secondary" Content="Abrir la web"
                                Command="{Binding OpenWebsiteCommand}" VerticalAlignment="Center" />
                        <Button Classes="social instagram" Command="{Binding OpenInstagramCommand}"
                                ToolTip.Tip="{Binding InstagramUrl}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{StaticResource InstagramIcon}" />
                                <TextBlock Text="{Binding InstagramHandle}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                    <TextBlock FontSize="12" Foreground="{DynamicResource MutedBrush}"
                               Text="{Binding WebsiteUrl}" />
                </StackPanel>
            </Border>

            <Border Classes="card" Margin="0,0,0,14" IsVisible="{Binding HasTeam}">
                <StackPanel>
                    <TextBlock Classes="sectionTitle" Text="EQUIPO Y AGRADECIMIENTOS" />
                    <TextBlock Classes="helpBody"
                               Text="Gente que hace posible HiveShock probándolo, ayudando en la comunidad y moderando. ¡Gracias!" />
                    <ItemsControl ItemsSource="{Binding Team}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CreditCategory">
                                <StackPanel Margin="0,6,0,4">
                                    <TextBlock Text="{Binding Header}" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <ItemsControl ItemsSource="{Binding Members}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:CreditMember">
                                                <Panel Margin="0,0,8,8">
                                                    <Button Classes="member" IsVisible="{Binding HasTikTok}"
                                                            Command="{Binding OpenTikTokCommand}"
                                                            ToolTip.Tip="Abrir su TikTok">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <PathIcon Data="{StaticResource TikTokIcon}" Width="13" Height="13" />
                                                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Border Classes="member" IsVisible="{Binding !HasTikTok}">
                                                        <TextBlock Text="{Binding Label}" />
                                                    </Border>
                                                </Panel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Classes="card" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Classes="sectionTitle" Text="APOYAR EL PROYECTO" />
                    <TextBlock Classes="helpBody"
                               Text="Si HiveShock te sirve en el stream, un café en Ko-fi ayuda a seguir mejorándolo. No es obligatorio: el programa se usa igual." />
                    <Button Classes="kofi" Content="Invitar un café"
                            Command="{Binding OpenKofiCommand}" HorizontalAlignment="Left" />
                    <TextBlock FontSize="12" Foreground="{DynamicResource MutedBrush}"
                               Text="{Binding KoFiUrl}" />
                </StackPanel>
            </Border>

            <TextBlock FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                       Text="Windows y macOS · live → efectos en el juego." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
