<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="using:HiveShock.Avalonia.Views.Controls"
             xmlns:vm="using:HiveShock.Avalonia.ViewModels"
             xmlns:conv="using:HiveShock.Avalonia.Converters"
             x:Class="HiveShock.Avalonia.Views.Pages.TikTokPage"
             x:DataType="vm:TikTokViewModel">
    <!--
        Cabecera de una sola línea (título + estado + cuenta) y pestañas compactas: casi todo el alto queda
        para el contenido. Las listas con editor (Regalos, Metas, Chat) son maestro/detalle.
    -->
    <DockPanel>
        <!-- ============================== Cabecera -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <!-- Cuenta -->
            <StackPanel DockPanel.Dock="Right" Classes="bar" Spacing="10" ctl:Tour.Key="tiktok.account">
                <ToggleSwitch IsChecked="{Binding Studio.TikTokEnabled}" IsEnabled="{Binding Studio.CanEditSetup}"
                              OnContent="Activo en este directo" OffContent="Desactivado"
                              ToolTip.Tip="Si está desactivado, HiveShock no se conecta al directo de TikTok." />
                <TextBox Width="200" Text="{Binding Studio.Channel}" IsEnabled="{Binding Studio.CanEditSetup}"
                         PlaceholderText="tu usuario, sin @">
                    <TextBox.InnerLeftContent>
                        <TextBlock Text="@" Margin="10,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource FaintBrush}" />
                    </TextBox.InnerLeftContent>
                </TextBox>
                <Button Classes="secondary" Margin="0" Content="Guardar"
                        Command="{Binding Studio.SaveChannelCommand}" IsEnabled="{Binding Studio.CanEditSetup}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource CardAltBrush}">
                    <ctl:Icon Data="{StaticResource Icon.TikTok}" Size="18" Foreground="{DynamicResource TextBrush}" />
                </Border>
                <StackPanel VerticalAlignment="Center" Spacing="1">
                    <TextBlock Classes="h1" FontSize="18" Text="TikTok" />
                    <TextBlock Text="{Binding Studio.TikTokPortStatus}" FontSize="12"
                               Foreground="{DynamicResource MutedBrush}"
                               Classes.tone-live="{Binding Studio.TikTokLive}"
                               Classes.tone-connecting="{Binding Studio.TikTokConnecting}"
                               Classes.tone-error="{Binding Studio.TikTokError}" />
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <TabControl>
            <!-- ============================== Regalos -->
            <!-- Arrastrar un regalo del catálogo hasta aquí abre la pestaña; soltarlo lo añade. -->
            <TabItem ctl:Tour.Key="tiktok.tab.gifts" ctl:ListGestures.SelectOnDragHover="True"
                     ctl:ListGestures.DropCommand="{Binding Gifts.DropFromCatalogCommand}">
                <TabItem.Header>
                    <StackPanel Classes="tabHeader">
                        <ctl:Icon Data="{StaticResource Icon.Gift}" />
                        <TextBlock Text="Regalos" />
                    </StackPanel>
                </TabItem.Header>
                <ContentControl Content="{Binding Gifts}" />
            </TabItem>

            <!-- ============================== Catálogo -->
            <TabItem ctl:Tour.Key="tiktok.tab.catalog">
                <TabItem.Header>
                    <StackPanel Classes="tabHeader">
                        <ctl:Icon Data="{StaticResource Icon.Book}" />
                        <TextBlock Text="Catálogo" />
                    </StackPanel>
                </TabItem.Header>
                <ContentControl Content="{Binding Catalog}" Margin="0,12,0,0" ctl:Tour.Key="tiktok.catalog" />
            </TabItem>

            <!-- ============================== Chat -->
            <TabItem ctl:Tour.Key="tiktok.tab.chat">
                <TabItem.Header>
                    <StackPanel Classes="tabHeader">
                        <ctl:Icon Data="{StaticResource Icon.Chat}" />
                        <TextBlock Text="Chat" />
                    </StackPanel>
                </TabItem.Header>
                <DockPanel Margin="0,12,0,0" ctl:Tour.Key="tiktok.chat">
                    <!-- Ajustes generales del chat en una franja. -->
                    <Border DockPanel.Dock="Top" Classes="section" Padding="14,10" Margin="0,0,0,12">
                        <WrapPanel ItemSpacing="20" LineSpacing="8" VerticalAlignment="Center">
                            <ToggleSwitch IsChecked="{Binding Events.ChatEnabled}"
                                          OnContent="Comandos activados" OffContent="Comandos desactivados" />
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Classes="fieldLabel" Margin="0" Text="Prefijo" VerticalAlignment="Center" />
                                <TextBox Text="{Binding Events.ChatPrefix}" Width="56" HorizontalContentAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                                        ToolTip.Tip="Segundos que cada espectador espera entre dos comandos.">
                                <TextBlock Classes="fieldLabel" Margin="0" Text="Espera por espectador" VerticalAlignment="Center" />
                                <TextBox Text="{Binding Events.ChatCooldownText}" Width="56" HorizontalContentAlignment="Center" />
                                <TextBlock Classes="caption" Text="s" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                                        ToolTip.Tip="Segundos mínimos entre dos comandos de cualquier espectador.">
                                <TextBlock Classes="fieldLabel" Margin="0" Text="Espera entre todos" VerticalAlignment="Center" />
                                <TextBox Text="{Binding Events.ChatGlobalGapText}" Width="56" HorizontalContentAlignment="Center" />
                                <TextBlock Classes="caption" Text="s" VerticalAlignment="Center" />
                            </StackPanel>
                        </WrapPanel>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280" MinWidth="220" MaxWidth="520" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" MinWidth="340" />
                        </Grid.ColumnDefinitions>

                        <Border Classes="panel">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Classes="paneHeader">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Classes="bar" Spacing="2">
                                            <Button Classes="icon" ctl:Hotkey.Gesture="Ctrl+N" Command="{Binding Events.AddCommandCommand}" ToolTip.Tip="Añadir comando (Ctrl+N)">
                                                <ctl:Icon Data="{StaticResource Icon.Plus}" />
                                            </Button>
                                            <Button Classes="icon" Command="{Binding Events.RemoveCommandCommand}" ToolTip.Tip="Eliminar el comando seleccionado (Supr)">
                                                <ctl:Icon Data="{StaticResource Icon.Trash}" />
                                            </Button>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Classes="h2" Text="Comandos" />
                                            <Border Classes="pill">
                                                <TextBlock Text="{Binding Events.ChatCommands.Count}" />
                                            </Border>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <Border DockPanel.Dock="Bottom" Classes="paneFooter">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Classes="primary" Margin="8,0,0,0" Command="{Binding Events.SaveCommand}">
                                            <StackPanel Classes="btnContent">
                                                <ctl:Icon Data="{StaticResource Icon.Save}" />
                                                <TextBlock Text="Guardar" />
                                            </StackPanel>
                                        </Button>
                                        <ctl:SaveStatusChip DataContext="{Binding Events.SaveStatus}" />
                                    </DockPanel>
                                </Border>
                                <Panel>
                                    <ListBox Classes="plain" ItemsSource="{Binding Events.ChatCommands}"
                                             SelectedItem="{Binding Events.SelectedCommand}"
                                             SelectedItems="{Binding Events.SelectedChatCommands}" SelectionMode="Multiple"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             ctl:ListGestures.DeleteCommand="{Binding Events.RemoveCommandCommand}"
                                             ctl:ListGestures.Reorder="True">
                                            <ListBox.ContextFlyout>
                                                <MenuFlyout>
                                                    <MenuItem Header="Eliminar" Command="{Binding Events.RemoveCommandCommand}">
                                                        <MenuItem.Icon>
                                                            <ctl:Icon Data="{StaticResource Icon.Trash}" Size="16" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                </MenuFlyout>
                                            </ListBox.ContextFlyout>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ChatCommandRowViewModel">
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Right" Classes="pill gold" Margin="8,0,0,0"
                                                            IsVisible="{Binding HasExtraSteps}">
                                                        <TextBlock Text="{Binding StepSummary}" />
                                                    </Border>
                                                    <StackPanel Spacing="2">
                                                        <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                                            <Run Text="{Binding $parent[UserControl].((vm:TikTokViewModel)DataContext).Events.ChatPrefix}"
                                                                 Foreground="{DynamicResource FaintBrush}" />
                                                            <Run Text="{Binding Word}" />
                                                        </TextBlock>
                                                        <TextBlock FontSize="12" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis">
                                                            <TextBlock.Text>
                                                                <MultiBinding Converter="{StaticResource EffectDisplay}">
                                                                    <Binding Path="Effect" />
                                                                    <Binding Path="$parent[UserControl].((vm:TikTokViewModel)DataContext).Events.EffectsWithNone" />
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <StackPanel Classes="empty" IsVisible="{Binding !Events.ChatCommands.Count}">
                                        <ctl:Icon Data="{StaticResource Icon.Chat}" />
                                        <TextBlock Classes="h2" Text="Sin comandos" />
                                        <TextBlock Classes="caption" Text="Crea uno con + (por ejemplo «saltar») y elige qué hace en el juego." />
                                    </StackPanel>
                                </Panel>
                            </DockPanel>
                        </Border>

                        <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

                        <Border Grid.Column="2" Classes="panel" Container.Name="editor" Container.Sizing="Width">
                            <Panel>
                                <StackPanel Classes="empty" IsVisible="{Binding Events.SelectedCommand, Converter={x:Static ObjectConverters.IsNull}}">
                                    <ctl:Icon Data="{StaticResource Icon.Chat}" />
                                    <TextBlock Classes="h2" Text="Elige un comando" />
                                    <TextBlock Classes="caption" Text="Selecciona un comando de la lista para editarlo." />
                                </StackPanel>
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              IsVisible="{Binding Events.SelectedCommand, Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <StackPanel Margin="20,18,20,24" MaxWidth="720" DataContext="{Binding Events.SelectedCommand}"
                                                x:DataType="vm:ChatCommandRowViewModel">
                                        <UniformGrid Classes="formRow">
                                            <StackPanel Grid.Column="0" Classes="field">
                                                <TextBlock Classes="fieldLabel" Text="Palabra que escribe el espectador" />
                                                <TextBox Text="{Binding Word}" PlaceholderText="p. ej. saltar" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Classes="field">
                                                <TextBlock Classes="fieldLabel" Text="Efecto" />
                                                <ComboBox HorizontalAlignment="Stretch"
                                                          ItemsSource="{Binding $parent[UserControl].((vm:TikTokViewModel)DataContext).Events.EffectsWithNone}"
                                                          SelectedValue="{Binding Effect}"
                                                          SelectedValueBinding="{Binding Id}"
                                                          DisplayMemberBinding="{Binding Display}" />
                                            </StackPanel>
                                        </UniformGrid>
                                        <ctl:StepListEditor DataContext="{Binding Steps}" Margin="0,6,0,0" />
                                    </StackPanel>
                                </ScrollViewer>
                            </Panel>
                        </Border>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- ============================== Eventos -->
            <TabItem ctl:Tour.Key="tiktok.tab.events">
                <TabItem.Header>
                    <StackPanel Classes="tabHeader">
                        <ctl:Icon Data="{StaticResource Icon.Bolt}" />
                        <TextBlock Text="Eventos" />
                    </StackPanel>
                </TabItem.Header>
                <DockPanel Margin="0,12,0,0" ctl:Tour.Key="tiktok.events">
                    <Border DockPanel.Dock="Bottom" Classes="paneFooter" Padding="0,10,0,0" BorderThickness="0">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Classes="primary" Margin="8,0,0,0" Command="{Binding Events.SaveCommand}">
                                <StackPanel Classes="btnContent">
                                    <ctl:Icon Data="{StaticResource Icon.Save}" />
                                    <TextBlock Text="Guardar" />
                                </StackPanel>
                            </Button>
                            <ctl:SaveStatusChip DataContext="{Binding Events.SaveStatus}" />
                        </DockPanel>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid ColumnDefinitions="*,12,*,12,*">
                            <!-- Seguidores -->
                            <Border Grid.Column="0" Classes="section" VerticalAlignment="Top">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,14">
                                        <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource AccentSubtleBrush}">
                                            <ctl:Icon Data="{StaticResource Icon.UserPlus}" Size="17" Foreground="{DynamicResource AccentTextBrush}" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Classes="h2" Text="Nuevo seguidor" />
                                            <TextBlock Classes="caption" Text="Cuando alguien te sigue" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Classes="field">
                                        <TextBlock Classes="fieldLabel" Text="Efecto" />
                                        <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Events.EffectsWithNone}"
                                                  SelectedValue="{Binding Events.FollowEffect}"
                                                  SelectedValueBinding="{Binding Id}"
                                                  DisplayMemberBinding="{Binding Display}" />
                                    </StackPanel>
                                    <CheckBox Content="Solo la primera vez que sigue" Margin="0,0,0,4"
                                              ToolTip.Tip="Evita el spam de seguir y dejar de seguir."
                                              IsChecked="{Binding Events.FollowOncePerUser}" />
                                    <Button Classes="ghost" Padding="8,4" MinHeight="28" Margin="0,0,0,10" HorizontalAlignment="Left"
                                            Content="Olvidar seguidores" Command="{Binding Events.ClearFollowHistoryCommand}" />
                                    <ctl:StepListEditor DataContext="{Binding Events.FollowSteps}" />
                                </StackPanel>
                            </Border>
                            <!-- Likes -->
                            <Border Grid.Column="2" Classes="section" VerticalAlignment="Top">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,14">
                                        <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource DangerSubtleBrush}">
                                            <ctl:Icon Data="{StaticResource Icon.Heart}" Size="17" Foreground="{DynamicResource DangerBrush}" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Classes="h2" Text="Likes" />
                                            <TextBlock Classes="caption" Text="Cada cierto número de likes" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Grid ColumnDefinitions="Auto,12,*">
                                        <StackPanel Grid.Column="0" Classes="field">
                                            <TextBlock Classes="fieldLabel" Text="Cada" />
                                            <TextBox Text="{Binding Events.LikesEveryText}" Width="80" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Classes="field">
                                            <TextBlock Classes="fieldLabel" Text="Efecto" />
                                            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Events.EffectsWithNone}"
                                                      SelectedValue="{Binding Events.LikesEffect}"
                                                      SelectedValueBinding="{Binding Id}"
                                                      DisplayMemberBinding="{Binding Display}" />
                                        </StackPanel>
                                    </Grid>
                                    <ctl:StepListEditor DataContext="{Binding Events.LikesSteps}" />
                                </StackPanel>
                            </Border>
                            <!-- Compartir -->
                            <Border Grid.Column="4" Classes="section" VerticalAlignment="Top">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,14">
                                        <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource OkSubtleBrush}">
                                            <ctl:Icon Data="{StaticResource Icon.Share}" Size="17" Foreground="{DynamicResource StatusOkBrush}" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Classes="h2" Text="Compartir" />
                                            <TextBlock Classes="caption" Text="Cuando alguien comparte el directo" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Classes="field">
                                        <TextBlock Classes="fieldLabel" Text="Efecto" />
                                        <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Events.EffectsWithNone}"
                                                  SelectedValue="{Binding Events.ShareEffect}"
                                                  SelectedValueBinding="{Binding Id}"
                                                  DisplayMemberBinding="{Binding Display}" />
                                    </StackPanel>
                                    <ctl:StepListEditor DataContext="{Binding Events.ShareSteps}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- ============================== Metas -->
            <TabItem ctl:Tour.Key="tiktok.tab.goals">
                <TabItem.Header>
                    <StackPanel Classes="tabHeader">
                        <ctl:Icon Data="{StaticResource Icon.Target}" />
                        <TextBlock Text="Metas" />
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="0,12,0,0" ctl:Tour.Key="tiktok.goals">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" MinWidth="220" MaxWidth="520" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" MinWidth="340" />
                    </Grid.ColumnDefinitions>

                    <Border Classes="panel">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Classes="paneHeader">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Classes="bar" Spacing="2">
                                        <Button Classes="icon" ctl:Hotkey.Gesture="Ctrl+N" Command="{Binding Goals.AddCommand}" ToolTip.Tip="Añadir meta (Ctrl+N)">
                                            <ctl:Icon Data="{StaticResource Icon.Plus}" />
                                        </Button>
                                        <Button Classes="icon" Command="{Binding Goals.RemoveCommand}" ToolTip.Tip="Eliminar la meta seleccionada (Supr)">
                                            <ctl:Icon Data="{StaticResource Icon.Trash}" />
                                        </Button>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Classes="h2" Text="Metas entre todos" />
                                        <Border Classes="pill">
                                            <TextBlock Text="{Binding Goals.Rows.Count}" />
                                        </Border>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border DockPanel.Dock="Bottom" Classes="paneFooter">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Classes="primary" Margin="8,0,0,0" Command="{Binding Goals.SaveCommand}">
                                        <StackPanel Classes="btnContent">
                                            <ctl:Icon Data="{StaticResource Icon.Save}" />
                                            <TextBlock Text="Guardar" />
                                        </StackPanel>
                                    </Button>
                                    <ctl:SaveStatusChip DataContext="{Binding Goals.SaveStatus}" />
                                </DockPanel>
                            </Border>
                            <Panel>
                                <ListBox Classes="plain" ItemsSource="{Binding Goals.Rows}" SelectedItem="{Binding Goals.Selected}"
                                         SelectedItems="{Binding Goals.SelectedRows}" SelectionMode="Multiple"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ctl:ListGestures.DeleteCommand="{Binding Goals.RemoveCommand}"
                                         ctl:ListGestures.Reorder="True">
                                        <ListBox.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuItem Header="Sumar 1 de prueba" Command="{Binding Goals.SimulateCommand}">
                                                    <MenuItem.Icon>
                                                        <ctl:Icon Data="{StaticResource Icon.Plus}" Size="16" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="Poner a cero" Command="{Binding Goals.ResetSelectedCommand}">
                                                    <MenuItem.Icon>
                                                        <ctl:Icon Data="{StaticResource Icon.Refresh}" Size="16" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <Separator />
                                                <MenuItem Header="Eliminar" Command="{Binding Goals.RemoveCommand}">
                                                    <MenuItem.Icon>
                                                        <ctl:Icon Data="{StaticResource Icon.Trash}" Size="16" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                            </MenuFlyout>
                                        </ListBox.ContextFlyout>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:GoalRowViewModel">
                                            <DockPanel>
                                                <Border DockPanel.Dock="Right" Classes="pill" Classes.ok="{Binding Closed}" Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding ProgressText}" />
                                                </Border>
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock FontSize="12" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis">
                                                        <TextBlock.Text>
                                                            <MultiBinding Converter="{StaticResource EffectDisplay}">
                                                                <Binding Path="Effect" />
                                                                <Binding Path="$parent[UserControl].((vm:TikTokViewModel)DataContext).Goals.EffectsWithNone" />
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel Classes="empty" IsVisible="{Binding !Goals.Rows.Count}">
                                    <ctl:Icon Data="{StaticResource Icon.Target}" />
                                    <TextBlock Classes="h2" Text="Sin metas" />
                                    <TextBlock Classes="caption" Text="Una meta junta regalos de todos los espectadores y lanza un efecto al llenarse." />
                                </StackPanel>
                            </Panel>
                        </DockPanel>
                    </Border>

                    <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

                    <Border Grid.Column="2" Classes="panel" Container.Name="editor" Container.Sizing="Width">
                        <Panel>
                            <StackPanel Classes="empty" IsVisible="{Binding Goals.Selected, Converter={x:Static ObjectConverters.IsNull}}">
                                <ctl:Icon Data="{StaticResource Icon.Target}" />
                                <TextBlock Classes="h2" Text="Elige una meta" />
                                <TextBlock Classes="caption" Text="Selecciona una meta de la lista para editarla." />
                            </StackPanel>
                            <DockPanel IsVisible="{Binding Goals.Selected, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <Border DockPanel.Dock="Top" Classes="paneHeader" Padding="16,10">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Classes="bar">
                                            <Button Classes="secondary" Margin="0" Command="{Binding Goals.ResetSelectedCommand}"
                                                    ToolTip.Tip="Vuelve a poner el progreso de esta meta a cero.">
                                                <StackPanel Classes="btnContent">
                                                    <ctl:Icon Data="{StaticResource Icon.Refresh}" />
                                                    <TextBlock Text="Poner a cero" />
                                                </StackPanel>
                                            </Button>
                                            <Button Classes="primary" Margin="0" Command="{Binding Goals.SimulateCommand}"
                                                    ToolTip.Tip="Suma un regalo a la meta, como si llegara uno de verdad.">
                                                <StackPanel Classes="btnContent">
                                                    <ctl:Icon Data="{StaticResource Icon.Plus}" />
                                                    <TextBlock Text="Sumar 1 de prueba" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <StackPanel VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Classes="h2" FontSize="16" Text="{Binding Goals.Selected.Label}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Classes="caption">
                                                <Run Text="Progreso: " />
                                                <Run Text="{Binding Goals.Selected.ProgressText}" FontWeight="SemiBold" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="20,18,20,24" MaxWidth="720" DataContext="{Binding Goals.Selected}"
                                                x:DataType="vm:GoalRowViewModel">
                                        <Grid ColumnDefinitions="*,16,Auto">
                                            <StackPanel Grid.Column="0" Classes="field">
                                                <TextBlock Classes="fieldLabel" Text="Nombre de la meta" />
                                                <TextBox Text="{Binding Label}" PlaceholderText="p. ej. Lluvia de rosas" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Classes="field">
                                                <TextBlock Classes="fieldLabel" Text="Regalos necesarios" />
                                                <TextBox Text="{Binding NeedText}" Width="120" />
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Classes="field">
                                            <TextBlock Classes="fieldLabel" Text="Regalos que cuentan (nombres o IDs, separados por coma)" />
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Classes="secondary" Margin="8,0,0,0"
                                                        Command="{Binding $parent[UserControl].((vm:TikTokViewModel)DataContext).Goals.AddGiftFromCatalogCommand}"
                                                        CommandParameter="{Binding}">
                                                    <StackPanel Classes="btnContent">
                                                        <ctl:Icon Data="{StaticResource Icon.Book}" />
                                                        <TextBlock Text="Del catálogo" />
                                                    </StackPanel>
                                                </Button>
                                                <TextBox Text="{Binding GiftsText}" />
                                            </DockPanel>
                                        </StackPanel>
                                        <StackPanel Classes="field">
                                            <TextBlock Classes="fieldLabel" Text="Efecto al llenarse" />
                                            <ComboBox HorizontalAlignment="Stretch"
                                                      ItemsSource="{Binding $parent[UserControl].((vm:TikTokViewModel)DataContext).Goals.EffectsWithNone}"
                                                      SelectedValue="{Binding Effect}"
                                                      SelectedValueBinding="{Binding Id}"
                                                      DisplayMemberBinding="{Binding Display}" />
                                        </StackPanel>
                                        <ctl:StepListEditor DataContext="{Binding Steps}" Margin="0,0,0,14" />
                                        <Border Classes="divider" Margin="0,0,0,12" />
                                        <StackPanel Spacing="6">
                                            <CheckBox Content="Cada regalo también dispara su propio efecto" IsChecked="{Binding AlsoInstant}" />
                                            <CheckBox Content="Se puede volver a llenar en este directo" IsChecked="{Binding Repeat}" />
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </DockPanel>
                        </Panel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ============================== Perfil (técnico) -->
            <TabItem ToolTip.Tip="Valores técnicos del perfil (profile.json y effects.json). Solo si sabes lo que haces.">
                <TabItem.Header>
                    <StackPanel Classes="tabHeader">
                        <ctl:Icon Data="{StaticResource Icon.Code}" />
                        <TextBlock Text="Avanzado" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="1100" HorizontalAlignment="Stretch">
                        <TextBlock Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,8"
                                   Text="profile.json y effects.json del perfil activo. Desconecta para poder guardar." />

                        <Border Margin="0,0,0,12" Padding="12,10" CornerRadius="10"
                                Background="{DynamicResource CardAltBrush}"
                                BorderBrush="{DynamicResource BrandGoldBrush}" BorderThickness="1">
                            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextBrush}">
                                <Run FontWeight="Bold" Foreground="{DynamicResource BrandGoldBrush}" Text="Atención: " />
                                <Run Text="estos son los valores técnicos que conectan HiveShock con el juego (puertos, IDs de efecto, qué cuenta como enemigo, etc.). Cambiarlos sin saber para qué sirven puede hacer que el puente deje de funcionar con este juego. Cada sección empieza bloqueada: marca &quot;Desbloquear para editar&quot; antes de tocar algo." />
                            </TextBlock>
                        </Border>

                        <Border Classes="card" Margin="0,0,0,12">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,4">
                                    <CheckBox DockPanel.Dock="Right" Content="Desbloquear para editar"
                                              IsChecked="{Binding ProfileEditor.ProfileSectionUnlocked}"
                                              IsEnabled="{Binding ProfileEditor.CanEdit}" />
                                    <TextBlock Classes="sectionTitle" Text="DATOS DEL PERFIL" Margin="0" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock Classes="fieldLabel" Text="Nombre" Margin="0,8,0,0" />
                                <TextBox Text="{Binding ProfileEditor.DisplayName}"
                                         IsEnabled="{Binding ProfileEditor.CanEditProfile}" />
                                <TextBlock Classes="fieldLabel" Text="Descripción" Margin="0,8,0,0" />
                                <TextBox Text="{Binding ProfileEditor.Description}" AcceptsReturn="True"
                                         TextWrapping="Wrap" MinHeight="48"
                                         IsEnabled="{Binding ProfileEditor.CanEditProfile}" />
                                <TextBlock Classes="fieldLabel" Text="Notas de ayuda" Margin="0,8,0,0" />
                                <TextBox Text="{Binding ProfileEditor.HelpNotes}" AcceptsReturn="True"
                                         TextWrapping="Wrap" MinHeight="48"
                                         IsEnabled="{Binding ProfileEditor.CanEditProfile}" />
                                <WrapPanel Margin="0,10,0,0" ItemSpacing="8">
                                    <DockPanel Margin="0,0,16,8" Width="200">
                                        <TextBlock Classes="fieldLabel" Text="Puerto juego" Width="110"
                                                   VerticalAlignment="Center" Margin="0" />
                                        <TextBox Text="{Binding ProfileEditor.GamePortText}"
                                                 IsEnabled="{Binding ProfileEditor.CanEditProfile}" />
                                    </DockPanel>
                                    <DockPanel Margin="0,0,16,8" Width="180">
                                        <TextBlock Classes="fieldLabel" Text="Puerto pruebas" Width="110"
                                                   VerticalAlignment="Center" Margin="0" />
                                        <TextBox Text="{Binding ProfileEditor.TestPortText}"
                                                 IsEnabled="{Binding ProfileEditor.CanEditProfile}" />
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,8" Width="180">
                                        <TextBlock Classes="fieldLabel" Text="Puerto eventos" Width="110"
                                                   VerticalAlignment="Center" Margin="0" />
                                        <TextBox Text="{Binding ProfileEditor.EventPortText}"
                                                 IsEnabled="{Binding ProfileEditor.CanEditProfile}" />
                                    </DockPanel>
                                </WrapPanel>
                                <WrapPanel Margin="0,4,0,0" ItemSpacing="20">
                                    <CheckBox Content="Contador de muertes" IsChecked="{Binding ProfileEditor.SupportsDeathEvents}"
                                              IsEnabled="{Binding ProfileEditor.CanEditProfile}" />
                                    <CheckBox Content="Borrar partida" IsChecked="{Binding ProfileEditor.SupportsDeleteSave}"
                                              IsEnabled="{Binding ProfileEditor.CanEditProfile}" />
                                    <CheckBox Content="Rescatar" IsChecked="{Binding ProfileEditor.SupportsRescue}"
                                              IsEnabled="{Binding ProfileEditor.CanEditProfile}" />
                                </WrapPanel>

                                <TextBlock Classes="sectionTitle" Text="ETIQUETAS (nombre para mostrar de cada efecto)" Margin="0,16,0,0" />
                                <WrapPanel Margin="0,4,0,4">
                                    <Button Classes="secondary" Content="Añadir" Command="{Binding ProfileEditor.AddLabelCommand}"
                                            IsEnabled="{Binding ProfileEditor.CanEditProfile}" />
                                    <Button Classes="secondary" Content="Quitar" Command="{Binding ProfileEditor.RemoveLabelCommand}"
                                            IsEnabled="{Binding ProfileEditor.CanEditProfile}" />
                                </WrapPanel>
                                <ListBox ItemsSource="{Binding ProfileEditor.Labels}"
                                         SelectedItem="{Binding ProfileEditor.SelectedLabel}"
                                         MaxHeight="180" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:LabelRow">
                                            <DockPanel>
                                                <TextBox DockPanel.Dock="Left" Width="200" Margin="0,0,8,0"
                                                         Text="{Binding Key}" PlaceholderText="ID del efecto"
                                                         IsEnabled="{Binding $parent[UserControl].((vm:TikTokViewModel)DataContext).ProfileEditor.CanEditProfile}" />
                                                <TextBox Text="{Binding Value}" PlaceholderText="nombre para mostrar"
                                                         IsEnabled="{Binding $parent[UserControl].((vm:TikTokViewModel)DataContext).ProfileEditor.CanEditProfile}" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <ctl:SaveStatusChip DataContext="{Binding ProfileEditor.SaveStatus}" HorizontalAlignment="Left" Margin="0,12,0,0" />
                                <Button Classes="primary" Content="Guardar profile.json" Margin="0,12,0,0"
                                        HorizontalAlignment="Left" Command="{Binding ProfileEditor.SaveProfileCommand}"
                                        IsEnabled="{Binding ProfileEditor.CanEditProfile}" />
                                <WrapPanel Margin="0,8,0,0">
                                    <Button Classes="secondary" Content="Importar profile.json…"
                                            Command="{Binding ProfileEditor.ImportProfileCommand}"
                                            IsEnabled="{Binding ProfileEditor.CanEditProfile}" />
                                    <Button Classes="secondary" Content="Exportar profile.json…"
                                            Command="{Binding ProfileEditor.ExportProfileCommand}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Classes="card">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,4">
                                    <CheckBox DockPanel.Dock="Right" Content="Desbloquear para editar"
                                              IsChecked="{Binding ProfileEditor.EffectsSectionUnlocked}"
                                              IsEnabled="{Binding ProfileEditor.CanEdit}" />
                                    <TextBlock Classes="sectionTitle" Text="EFECTOS (comandos que se mandan al juego)"
                                               Margin="0" VerticalAlignment="Center" />
                                </DockPanel>
                                <Grid ColumnDefinitions="1.1*,8,*" Margin="0,8,0,0">
                                    <StackPanel Grid.Column="0">
                                        <WrapPanel>
                                            <Button Classes="secondary" Content="Nuevo" Command="{Binding ProfileEditor.AddEffectCommand}"
                                                    IsEnabled="{Binding ProfileEditor.CanEditEffects}" />
                                            <Button Classes="secondary" Content="Quitar" Command="{Binding ProfileEditor.RemoveEffectCommand}"
                                                    IsEnabled="{Binding ProfileEditor.CanEditEffects}" />
                                        </WrapPanel>
                                        <ListBox ItemsSource="{Binding ProfileEditor.Effects}"
                                                 SelectedItem="{Binding ProfileEditor.SelectedEffect}"
                                                 MinHeight="220" MaxHeight="360" Margin="0,4,0,0"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:EffectRow">
                                                    <DockPanel
                                                        IsEnabled="{Binding $parent[UserControl].((vm:TikTokViewModel)DataContext).ProfileEditor.CanEditEffects}">
                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="10"
                                                                    VerticalAlignment="Center">
                                                            <CheckBox Content="Enemigo" IsChecked="{Binding IsEnemy}" />
                                                            <CheckBox Content="Solo uno a la vez" IsChecked="{Binding IsSingleton}" />
                                                        </StackPanel>
                                                        <TextBox Text="{Binding Id}" />
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                    <Border Grid.Column="2">
                                        <StackPanel DataContext="{Binding ProfileEditor.SelectedEffect}">
                                            <TextBlock Classes="fieldLabel" Text="Propiedades del comando" />
                                            <WrapPanel Margin="0,4,0,4">
                                                <Button Classes="secondary" Content="Añadir" Command="{Binding AddPropertyCommand}"
                                                        IsEnabled="{Binding $parent[UserControl].((vm:TikTokViewModel)DataContext).ProfileEditor.CanEditEffects}" />
                                                <Button Classes="secondary" Content="Quitar" Command="{Binding RemovePropertyCommand}"
                                                        IsEnabled="{Binding $parent[UserControl].((vm:TikTokViewModel)DataContext).ProfileEditor.CanEditEffects}" />
                                            </WrapPanel>
                                            <ListBox ItemsSource="{Binding Properties}"
                                                     SelectedItem="{Binding SelectedProperty}"
                                                     MinHeight="220" MaxHeight="320"
                                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:EffectPropertyRow">
                                                        <DockPanel Margin="0,2"
                                                            IsEnabled="{Binding $parent[UserControl].((vm:TikTokViewModel)DataContext).ProfileEditor.CanEditEffects}">
                                                            <ComboBox DockPanel.Dock="Right" Width="100" Margin="8,0,0,0"
                                                                      ItemsSource="{x:Static vm:EffectPropertyRow.KindOptions}"
                                                                      SelectedItem="{Binding Kind}">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock Text="{Binding Converter={x:Static conv:EditableValueKindLabelConverter.Instance}}" />
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                            </ComboBox>
                                                            <TextBox DockPanel.Dock="Left" Width="130" Margin="0,0,8,0"
                                                                     Text="{Binding Key}" PlaceholderText="clave" />
                                                            <TextBox Text="{Binding Value}" PlaceholderText="valor" />
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <ctl:SaveStatusChip DataContext="{Binding ProfileEditor.SaveStatus}" HorizontalAlignment="Left" Margin="0,12,0,0" />
                                <Button Classes="primary" Content="Guardar effects.json" Margin="0,12,0,0"
                                        HorizontalAlignment="Left" Command="{Binding ProfileEditor.SaveEffectsCommand}"
                                        IsEnabled="{Binding ProfileEditor.CanEditEffects}" />
                                <WrapPanel Margin="0,8,0,0">
                                    <Button Classes="secondary" Content="Importar effects.json…"
                                            Command="{Binding ProfileEditor.ImportEffectsCommand}"
                                            IsEnabled="{Binding ProfileEditor.CanEditEffects}" />
                                    <Button Classes="secondary" Content="Exportar effects.json…"
                                            Command="{Binding ProfileEditor.ExportEffectsCommand}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================== Debug -->
            <TabItem IsVisible="{Binding IsDebugBuild}">
                <TabItem.Header>
                    <StackPanel Classes="tabHeader">
                        <ctl:Icon Data="{StaticResource Icon.Bug}" />
                        <TextBlock Text="Diagnóstico" />
                    </StackPanel>
                </TabItem.Header>
                <ContentControl Content="{Binding Diagnostics}" Margin="0,12,0,0" />
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
