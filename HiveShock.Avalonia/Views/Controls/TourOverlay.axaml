<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HiveShock.Avalonia.ViewModels"
             xmlns:ctl="using:HiveShock.Avalonia.Views.Controls"
             x:Class="HiveShock.Avalonia.Views.Controls.TourOverlay"
             x:DataType="vm:TutorialViewModel"
             Focusable="True">
    <!--
        Capa del tutorial: oscurece la ventana salvo el objetivo del paso (TourSpotlight) y muestra la tarjeta
        al lado que tenga sitio. El fondo transparente recoge todos los clics: durante el tutorial no se puede
        tocar la app por accidente (por ejemplo, conectar). Teclado: → / Intro siguiente, ← atrás, Esc salir.
    -->
    <Panel Background="Transparent">
        <ctl:TourSpotlight x:Name="Spot" />
        <Canvas x:Name="Layer">
            <Border x:Name="Card" Width="360" Padding="20,18" CornerRadius="12"
                    Background="{DynamicResource PopupBrush}"
                    BorderBrush="{DynamicResource StrongBorderBrush}" BorderThickness="1"
                    BoxShadow="0 12 32 0 #66000000">
                <Border.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Canvas.Left" Duration="0:0:0.22" Easing="CubicEaseOut" />
                        <DoubleTransition Property="Canvas.Top" Duration="0:0:0.22" Easing="CubicEaseOut" />
                        <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                    </Transitions>
                </Border.Transitions>
                <StackPanel Spacing="12">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Classes="icon" Width="28" Height="28" Margin="0,-6,-8,0"
                                Command="{Binding FinishCommand}" ToolTip.Tip="Salir del tutorial (Esc)">
                            <ctl:Icon Data="{StaticResource Icon.Close}" Size="15" />
                        </Button>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border Width="22" Height="22" CornerRadius="11" Background="{DynamicResource GoldSubtleBrush}">
                                <ctl:Icon Data="{StaticResource Icon.Help}" Size="14" Foreground="{DynamicResource GoldTextBrush}" />
                            </Border>
                            <TextBlock Classes="overline" Text="{Binding StepText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </DockPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Classes="h2" FontSize="17" Text="{Binding Title}" TextWrapping="Wrap" />
                        <TextBlock Classes="body" LineHeight="20" Foreground="{DynamicResource MutedBrush}"
                                   Text="{Binding Body}" />
                    </StackPanel>

                    <ProgressBar Height="4" MinHeight="4" Minimum="0" Maximum="100" Value="{Binding Progress}"
                                 Foreground="{DynamicResource BrandGoldBrush}" Background="{DynamicResource CardAltBrush}"
                                 CornerRadius="2" />

                    <DockPanel>
                        <Button DockPanel.Dock="Left" Classes="ghost" Content="Saltar tutorial" Padding="8,4" MinHeight="30"
                                Foreground="{DynamicResource MutedBrush}" Command="{Binding FinishCommand}"
                                IsVisible="{Binding !IsLast}" />
                        <StackPanel Classes="bar" HorizontalAlignment="Right" Spacing="8">
                            <Button Classes="secondary" Margin="0" Content="Atrás" Command="{Binding BackCommand}"
                                    IsVisible="{Binding CanGoBack}" />
                            <Button x:Name="NextButton" Classes="primary" Margin="0" MinWidth="96"
                                    HorizontalContentAlignment="Center" Command="{Binding NextCommand}">
                                <StackPanel Classes="btnContent">
                                    <TextBlock Text="{Binding NextLabel}" />
                                    <ctl:Icon Data="{StaticResource Icon.ChevronRight}" IsVisible="{Binding !IsLast}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Canvas>
    </Panel>
</UserControl>
