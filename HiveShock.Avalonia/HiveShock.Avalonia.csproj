<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>HiveShock.Avalonia</RootNamespace>
    <AssemblyName>HiveShock</AssemblyName>
    <Product>HiveShock</Product>
    <AssemblyTitle>HiveShock</AssemblyTitle>
    <Company>Yafel</Company>
    <OutputType>WinExe</OutputType>
    <!--
      net10.0-windows10.0.19041.0 es el que trae Smart TTS de verdad: NAudio (WASAPI/WinMM)
      y SharpHook solo exponen sus tipos reales bajo un TFM Windows-versionado, así que
      HiveShock.Desktop (quien los implementa) solo puede vivir ahí — ver su .csproj.
      Un solo TFM según el host/RID: en Windows (sin -r, o -r win-*) se usa el de Windows,
      así `dotnet run`, el IDE y Pack-Release.ps1 llevan TTS sin pasar -f. En Mac/Linux, o
      publicando para osx-*/linux-*, queda net10.0 (la página "Voz" sale como no disponible).
      Forzar otro: -p:TargetFramework=net10.0 (o el de Windows desde Mac/Linux).
    -->
    <TargetFramework Condition="'$(TargetFramework)' == '' and $([MSBuild]::IsOSPlatform('windows')) and ('$(RuntimeIdentifier)' == '' or $(RuntimeIdentifier.StartsWith('win')))">net10.0-windows10.0.19041.0</TargetFramework>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- Deja compilar el TFM Windows-only desde Linux/Mac (solo build, no ejecución). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <!-- Windows-only host bits. Do not pin RuntimeIdentifier: `dotnet run` uses the machine OS. -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('windows'))">
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">
    <DefineConstants>$(DefineConstants);HIVESHOCK_WINDOWS_DESKTOP</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release' and '$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <!-- Single-file is reliable on Windows. On macOS/Linux Avalonia native libs prefer a folder publish. -->
  <PropertyGroup Condition="'$(Configuration)'=='Release' and '$(RuntimeIdentifier)' != '' and $(RuntimeIdentifier.StartsWith('win'))">
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HiveShock.Core\HiveShock.Core.csproj" />
    <!-- Voces locales Piper: multiplataforma (el motor se descarga aparte, ver su .csproj). -->
    <ProjectReference Include="..\HiveShock.Voice.Piper\HiveShock.Voice.Piper.csproj" />
  </ItemGroup>

  <!-- Solo la pata Windows referencia Desktop: es el único TFM con el que es compatible. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">
    <ProjectReference Include="..\HiveShock.Desktop\HiveShock.Desktop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\config\profiles\**\*" Link="profiles\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="..\config\active-profile.txt" Link="active-profile.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="..\config\gift-catalog.json" Link="gift-catalog.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="..\config\.env.example" Link=".env.example">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="..\config\gifts-images\**\*" Link="gifts-images\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>
</Project>
