<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HiveShock.Avalonia.ViewModels"
             x:Class="HiveShock.Avalonia.Views.Pages.TwitchPage"
             x:DataType="vm:TwitchViewModel">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Classes="pageTitle" Text="Twitch" />

            <Border Classes="card" Margin="0,8,0,16">
                <StackPanel>
                    <CheckBox Content="Usar en este directo" IsChecked="{Binding Studio.TwitchEnabled}"
                              IsEnabled="{Binding Studio.CanEditSetup}" Margin="0,0,0,12" />
                    <TextBlock FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"
                               Text="{Binding Studio.TwitchLogin, StringFormat=@{0}}"
                               IsVisible="{Binding Studio.TwitchHasAccount}" />
                    <WrapPanel>
                        <Button Classes="primary" Content="Entrar con Twitch"
                                Command="{Binding Studio.ConnectTwitchCommand}"
                                IsEnabled="{Binding Studio.CanTwitchConnect}"
                                IsVisible="{Binding !Studio.TwitchHasAccount}" />
                        <Button Classes="secondary" Content="Salir"
                                Command="{Binding Studio.DisconnectTwitchCommand}"
                                IsEnabled="{Binding Studio.CanEditSetup}"
                                IsVisible="{Binding Studio.TwitchHasAccount}" />
                    </WrapPanel>
                    <TextBlock FontSize="12" FontWeight="SemiBold" Margin="0,10,0,0"
                               Text="{Binding Studio.TwitchPortStatus}"
                               Foreground="{DynamicResource MutedBrush}" />
                </StackPanel>
            </Border>

            <Border Classes="card" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Classes="sectionTitle" Text="PALABRAS DEL CHAT" />
                    <CheckBox Content="Activar" IsChecked="{Binding Events.TwitchChatEnabled}" />
                    <DockPanel Margin="0,10,0,12">
                        <TextBlock Classes="fieldLabel" Text="Prefijo" Width="90" VerticalAlignment="Center" />
                        <TextBox Text="{Binding Events.TwitchChatPrefix}" Width="64" HorizontalAlignment="Left" />
                    </DockPanel>
                    <WrapPanel>
                        <Button Classes="secondary" Content="Añadir" Command="{Binding Events.AddTwitchCommandCommand}" />
                        <Button Classes="secondary" Content="Quitar" Command="{Binding Events.RemoveTwitchCommandCommand}" />
                    </WrapPanel>
                    <ListBox ItemsSource="{Binding Events.TwitchChatCommands}"
                             SelectedItem="{Binding Events.SelectedTwitchCommand}"
                             MaxHeight="220" Margin="0,8,0,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ChatCommandRowViewModel">
                                <DockPanel>
                                    <ComboBox DockPanel.Dock="Right" Width="220" Margin="8,0,0,0"
                                              ItemsSource="{Binding $parent[UserControl].((vm:TwitchViewModel)DataContext).Events.EffectsWithNone}"
                                              SelectedValue="{Binding Effect}"
                                              SelectedValueBinding="{Binding Id}"
                                              DisplayMemberBinding="{Binding Display}" />
                                    <TextBox Text="{Binding Word}" PlaceholderText="palabra" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <Border Classes="card" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Classes="sectionTitle" Text="NUEVOS SEGUIDORES" />
                    <ComboBox ItemsSource="{Binding Events.EffectsWithNone}"
                              SelectedValue="{Binding Events.TwitchFollowEffect}"
                              SelectedValueBinding="{Binding Id}"
                              DisplayMemberBinding="{Binding Display}" />
                </StackPanel>
            </Border>

            <Border Classes="card" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Classes="sectionTitle" Text="BITS" />
                    <TextBlock FontSize="12" Margin="0,0,0,10" Foreground="{DynamicResource MutedBrush}"
                               Text="Desde X bits se usa el umbral más alto que cumpla. Lista vacía = se ignoran." />
                    <WrapPanel>
                        <Button Classes="secondary" Content="Añadir" Command="{Binding Events.AddBitsRuleCommand}" />
                        <Button Classes="secondary" Content="Quitar" Command="{Binding Events.RemoveBitsRuleCommand}" />
                    </WrapPanel>
                    <ListBox ItemsSource="{Binding Events.TwitchBits}"
                             SelectedItem="{Binding Events.SelectedBitsRule}"
                             MaxHeight="220" Margin="0,8,0,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:BitsRowViewModel">
                                <DockPanel>
                                    <ComboBox DockPanel.Dock="Right" Width="220" Margin="8,0,0,0"
                                              ItemsSource="{Binding $parent[UserControl].((vm:TwitchViewModel)DataContext).Events.EffectsWithNone}"
                                              SelectedValue="{Binding Effect}"
                                              SelectedValueBinding="{Binding Id}"
                                              DisplayMemberBinding="{Binding Display}" />
                                    <TextBox Text="{Binding MinText}" PlaceholderText="mín. bits" Width="88"
                                             HorizontalAlignment="Left" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <Button Classes="primary" Content="Guardar" Command="{Binding Events.SaveCommand}"
                    HorizontalAlignment="Left" MinWidth="140" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
