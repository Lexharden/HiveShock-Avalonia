<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Iconos de trazo sobre un lienzo de 24×24, dibujados con el control ctl:Icon (Views/Controls/Icon.cs).
        Son geometrías propias y simples (sin dependencias ni fuentes del sistema), con trazo redondeado.
        Convención: nombres Icon.<Concepto>. Un punto suelto se hace con "h0.01" (el extremo redondo lo dibuja).
    -->

    <!-- Navegación -->
    <StreamGeometry x:Key="Icon.Home">M 3.5 10.5 L 12 3.5 L 20.5 10.5 M 5.5 9 L 5.5 20 L 10 20 L 10 14.5 L 14 14.5 L 14 20 L 18.5 20 L 18.5 9</StreamGeometry>
