<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="using:HiveShock.Avalonia.Views.Controls"
             xmlns:vm="using:HiveShock.Avalonia.ViewModels"
             x:Class="HiveShock.Avalonia.Views.Pages.KeyMacrosPage"
             x:DataType="vm:KeyMacrosViewModel">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <ctl:SaveStatusChip DockPanel.Dock="Right" DataContext="{Binding SaveStatus}" VerticalAlignment="Center" />
            <StackPanel Spacing="2">
                <TextBlock Classes="h1" Text="Teclas" />
                <TextBlock Classes="caption"
                           Text="Pulsa teclas en la ventana del juego cuando pasa algo en el live. Cada macro aparece como un efecto más en Regalos, Chat y Eventos." />
            </StackPanel>
        </DockPanel>

        <Border DockPanel.Dock="Top" Classes="callout warn" Margin="0,8,0,0" IsVisible="{Binding !IsSupported}">
            <TextBlock Classes="caption" Foreground="{DynamicResource TextBrush}" Text="{Binding WindowStatusText}" />
        </Border>

        <TabControl>
            <!-- ================================================= Macros -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Classes="tabHeader">
                        <ctl:Icon Data="{StaticResource Icon.Keyboard}" />
                        <TextBlock Text="Macros" />
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240" MinWidth="200" MaxWidth="460" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" MinWidth="340" />
                    </Grid.ColumnDefinitions>

                    <!-- Lista -->
                    <Border Classes="panel" ctl:Tour.Key="keys.list">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Classes="paneHeader">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Classes="bar" Spacing="2">
                                        <Button Classes="icon" Command="{Binding AddMacroCommand}" ToolTip.Tip="Nueva macro">
                                            <ctl:Icon Data="{StaticResource Icon.Plus}" />
                                        </Button>
                                        <Button Classes="icon" Command="{Binding DuplicateMacroCommand}" IsEnabled="{Binding HasSelection}"
                                                ToolTip.Tip="Duplicar la macro seleccionada">
                                            <ctl:Icon Data="{StaticResource Icon.Copy}" />
                                        </Button>
                                        <Button Classes="icon" Command="{Binding RemoveMacroCommand}" IsEnabled="{Binding HasSelection}"
                                                ToolTip.Tip="Quitar la macro seleccionada">
                                            <ctl:Icon Data="{StaticResource Icon.Trash}" />
                                        </Button>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Classes="h2" Text="Macros" />
                                        <Border Classes="pill"><TextBlock Text="{Binding Macros.Count}" /></Border>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Panel>
                                <ListBox Classes="plain" ItemsSource="{Binding Macros}" SelectedItem="{Binding SelectedMacro}"
                                         IsVisible="{Binding HasMacros}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:KeyMacroRow">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Id}" Classes="mono" FontSize="11"
                                                           Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel Classes="empty" IsVisible="{Binding !HasMacros}">
                                    <ctl:Icon Data="{StaticResource Icon.Keyboard}" />
                                    <TextBlock Classes="h2" Text="Todavía no hay macros" />
                                    <TextBlock Classes="caption" Text="Crea una con + y asígnala a un comando de chat (!saltar), un regalo o un evento." />
                                </StackPanel>
                            </Panel>
                        </DockPanel>
                    </Border>

                    <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

                    <!-- Editor -->
                    <Border Grid.Column="2" Classes="panel" Container.Name="editor" Container.Sizing="Width">
                        <Panel>
                            <StackPanel Classes="empty" IsVisible="{Binding !HasSelection}">
                                <ctl:Icon Data="{StaticResource Icon.Keyboard}" />
                                <TextBlock Classes="h2" Text="Elige una macro" />
                                <TextBlock Classes="caption" Text="Selecciona una macro de la lista para editar sus teclas." />
                            </StackPanel>

                            <DockPanel IsVisible="{Binding HasSelection}">
                                <Border DockPanel.Dock="Top" Classes="paneHeader" Padding="16,10">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Classes="primary" Margin="0" Command="{Binding TestMacroCommand}"
                                                ToolTip.Tip="Ejecuta la macro ahora en la ventana del juego.">
                                            <StackPanel Classes="btnContent">
                                                <ctl:Icon Data="{StaticResource Icon.Play}" />
                                                <TextBlock Text="Probar macro" />
                                            </StackPanel>
                                        </Button>
                                        <StackPanel VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Classes="h2" FontSize="16" Text="{Binding SelectedMacro.Title}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Classes="caption" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                       Text="Elígela como «efecto» en Chat, Regalos o Eventos. Los cambios valen al momento." />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <!-- Avisos de validación / resultado de la prueba -->
                                <StackPanel DockPanel.Dock="Bottom">
                                    <Border Classes="callout danger" Margin="12,0,12,12" IsVisible="{Binding HasValidationText}">
                                        <TextBlock Classes="caption" Foreground="{DynamicResource DangerBrush}" Text="{Binding ValidationText}" />
                                    </Border>
                                    <TextBlock Classes="caption" Margin="16,0,16,12" Text="{Binding Message}"
                                               IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                </StackPanel>

                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="20,18,20,24" Spacing="20">
                                        <!-- General -->
                                        <StackPanel DataContext="{Binding SelectedMacro}" x:DataType="vm:KeyMacroRow">
                                            <TextBlock Classes="overline" Text="GENERAL" Margin="0,0,0,12" />
                                            <UniformGrid Classes="formRow">
                                                <StackPanel Grid.Column="0" Classes="field">
                                                    <TextBlock Classes="fieldLabel" Text="Nombre" />
                                                    <TextBox Text="{Binding Label}" PlaceholderText="Saltar" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Classes="field">
                                                    <TextBlock Classes="fieldLabel" Text="Id (lo que se elige al asignarla)" />
                                                    <TextBox Classes="mono" Text="{Binding Id}" PlaceholderText="saltar" />
                                                </StackPanel>
                                            </UniformGrid>
                                            <Grid ColumnDefinitions="*,16,Auto">
                                                <StackPanel Grid.Column="0" Classes="field">
                                                    <TextBlock Classes="fieldLabel" Text="Si se activa otra vez mientras está en marcha" />
                                                    <ComboBox HorizontalAlignment="Stretch" ItemsSource="{x:Static vm:KeyMacroRow.OverlapChoices}"
                                                              SelectedValue="{Binding Overlap}" SelectedValueBinding="{Binding Value}"
                                                              DisplayMemberBinding="{Binding Display}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Classes="field">
                                                    <TextBlock Classes="fieldLabel" Text="Duración máxima" />
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBox Text="{Binding MaxTotalText}" Width="100" />
                                                        <TextBlock Classes="caption" Text="ms" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                            <StackPanel Classes="field">
                                                <TextBlock Classes="fieldLabel" Text="Atajo global (opcional)" />
                                                <DockPanel>
                                                    <StackPanel DockPanel.Dock="Right" Classes="bar" Margin="8,0,0,0">
                                                        <Button Classes="secondary" Margin="0"
                                                                Content="{Binding $parent[UserControl].((vm:KeyMacrosViewModel)DataContext).HotkeyCaptureLabel}"
                                                                Command="{Binding $parent[UserControl].((vm:KeyMacrosViewModel)DataContext).BeginHotkeyCaptureCommand}" />
                                                        <Button Classes="icon" ToolTip.Tip="Quitar el atajo"
                                                                Command="{Binding $parent[UserControl].((vm:KeyMacrosViewModel)DataContext).ClearHotkeyCommand}">
                                                            <ctl:Icon Data="{StaticResource Icon.Close}" Size="16" />
                                                        </Button>
                                                    </StackPanel>
                                                    <TextBox Text="{Binding HotkeyText}" PlaceholderText="Ctrl+Alt+F5" />
                                                </DockPanel>
                                                <TextBlock Classes="caption" FontSize="11"
                                                           Text="Lanza la macro a mano desde cualquier ventana. Necesita Ctrl, Alt, Shift o Win para no quitarle esa tecla al juego." />
                                            </StackPanel>
                                            <CheckBox IsChecked="{Binding AllowDangerous}"
                                                      Content="Permitir combinaciones bloqueadas (Win, Alt+F4, Alt+Tab, Ctrl+Alt+Supr)" />
                                        </StackPanel>

                                        <!-- Pasos -->
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,8">
                                                <Button DockPanel.Dock="Right" Classes="ghost" Padding="8,4" MinHeight="28"
                                                        Command="{Binding AddStepCommand}">
                                                    <StackPanel Classes="btnContent">
                                                        <ctl:Icon Data="{StaticResource Icon.Plus}" />
                                                        <TextBlock Text="Añadir paso" />
                                                    </StackPanel>
                                                </Button>
                                                <TextBlock Classes="overline" Text="PASOS" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <Border Classes="panel" Background="{DynamicResource CardAltBrush}"
                                                    DataContext="{Binding SelectedMacro}" x:DataType="vm:KeyMacroRow">
                                                <ItemsControl ItemsSource="{Binding Steps}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:KeyStepRow">
                                                            <Border Padding="10,8" BorderThickness="0,0,0,1"
                                                                    BorderBrush="{DynamicResource BorderBrush}">
                                                                <DockPanel>
                                                                    <StackPanel DockPanel.Dock="Right" Classes="bar" Spacing="0" Margin="8,0,0,0">
                                                                        <Button Classes="icon" Width="28" Height="28" ToolTip.Tip="Subir"
                                                                                CommandParameter="{Binding}"
                                                                                Command="{Binding $parent[UserControl].((vm:KeyMacrosViewModel)DataContext).MoveStepUpCommand}">
                                                                            <ctl:Icon Data="{StaticResource Icon.ChevronDown}" Size="15">
                                                                                <ctl:Icon.RenderTransform>
                                                                                    <RotateTransform Angle="180" />
                                                                                </ctl:Icon.RenderTransform>
                                                                            </ctl:Icon>
                                                                        </Button>
                                                                        <Button Classes="icon" Width="28" Height="28" ToolTip.Tip="Bajar"
                                                                                CommandParameter="{Binding}"
                                                                                Command="{Binding $parent[UserControl].((vm:KeyMacrosViewModel)DataContext).MoveStepDownCommand}">
                                                                            <ctl:Icon Data="{StaticResource Icon.ChevronDown}" Size="15" />
                                                                        </Button>
                                                                        <Button Classes="icon" Width="28" Height="28" ToolTip.Tip="Quitar este paso"
                                                                                CommandParameter="{Binding}"
                                                                                Command="{Binding $parent[UserControl].((vm:KeyMacrosViewModel)DataContext).RemoveStepCommand}">
                                                                            <ctl:Icon Data="{StaticResource Icon.Trash}" Size="15" />
                                                                        </Button>
                                                                    </StackPanel>
                                                                    <WrapPanel ItemSpacing="8" LineSpacing="6" VerticalAlignment="Center">
                                                                        <ComboBox ItemsSource="{x:Static vm:KeyStepRow.ActionChoices}"
                                                                                  SelectedValue="{Binding Action}" SelectedValueBinding="{Binding Value}"
                                                                                  DisplayMemberBinding="{Binding Display}" Width="150" />
                                                                        <ComboBox ItemsSource="{x:Static vm:KeyStepRow.KeyNames}"
                                                                                  SelectedItem="{Binding Key}" Width="110" />
                                                                        <Button Classes="secondary" Margin="0" Content="{Binding CaptureLabel}"
                                                                                CommandParameter="{Binding}"
                                                                                Command="{Binding $parent[UserControl].((vm:KeyMacrosViewModel)DataContext).BeginCaptureCommand}" />
                                                                        <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding ShowHold}"
                                                                                    ToolTip.Tip="Cuánto tiempo se mantiene pulsada">
                                                                            <TextBox Text="{Binding HoldText}" Width="70" />
                                                                            <TextBlock Classes="caption" Text="ms" VerticalAlignment="Center" />
                                                                        </StackPanel>
                                                                        <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding ShowRepeat}"
                                                                                    ToolTip.Tip="Veces que se repite">
                                                                            <TextBlock Classes="caption" Text="×" VerticalAlignment="Center" />
                                                                            <TextBox Text="{Binding RepeatText}" Width="56" />
                                                                        </StackPanel>
                                                                        <StackPanel Orientation="Horizontal" Spacing="4" ToolTip.Tip="Espera después de este paso">
                                                                            <ctl:Icon Data="{StaticResource Icon.Clock}" Size="15"
                                                                                      Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                                                                            <TextBox Text="{Binding DelayText}" Width="66" />
                                                                            <TextBlock Classes="caption" Text="ms" VerticalAlignment="Center" />
                                                                        </StackPanel>
                                                                        <StackPanel Orientation="Horizontal" Spacing="4" ToolTip.Tip="Variación aleatoria de los tiempos">
                                                                            <TextBlock Classes="caption" Text="±" VerticalAlignment="Center" />
                                                                            <TextBox Text="{Binding JitterText}" Width="52" />
                                                                            <TextBlock Classes="caption" Text="%" VerticalAlignment="Center" />
                                                                        </StackPanel>
                                                                    </WrapPanel>
                                                                </DockPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </DockPanel>
                        </Panel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ================================================= Ventana -->
            <TabItem IsVisible="{Binding IsSupported}">
                <TabItem.Header>
                    <StackPanel Classes="tabHeader">
                        <ctl:Icon Data="{StaticResource Icon.Monitor}" />
                        <TextBlock Text="Ventana del juego" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                    <Border Classes="section" MaxWidth="720" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,14">
                                <Border DockPanel.Dock="Left" Width="32" Height="32" CornerRadius="8" Margin="0,0,10,0"
                                        Background="{DynamicResource AccentSubtleBrush}">
                                    <ctl:Icon Data="{StaticResource Icon.Monitor}" Size="17" Foreground="{DynamicResource AccentTextBrush}" />
                                </Border>
                                <TextBlock Text="{Binding WindowStatusText}" FontWeight="SemiBold" TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                            <StackPanel Classes="field">
                                <TextBlock Classes="fieldLabel" Text="Elegir una ventana abierta" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Classes="secondary" Margin="8,0,0,0"
                                            Command="{Binding RefreshOpenWindowsCommand}">
                                        <StackPanel Classes="btnContent">
                                            <ctl:Icon Data="{StaticResource Icon.Refresh}" />
                                            <TextBlock Text="Actualizar" />
                                        </StackPanel>
                                    </Button>
                                    <ComboBox ItemsSource="{Binding OpenWindows}" SelectedItem="{Binding SelectedOpenWindow}"
                                              HorizontalAlignment="Stretch" PlaceholderText="Abre el juego y pulsa Actualizar">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:OpenWindowChoice">
                                                <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </DockPanel>
                            </StackPanel>
                            <UniformGrid Classes="formRow">
                                <StackPanel Grid.Column="0" Classes="field">
                                    <TextBlock Classes="fieldLabel" Text="Proceso" />
                                    <TextBox Text="{Binding WindowProcess}" PlaceholderText="p. ej. soh (sin .exe)" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Classes="field">
                                    <TextBlock Classes="fieldLabel" Text="El título contiene (opcional)" />
                                    <TextBox Text="{Binding WindowTitle}" PlaceholderText="p. ej. Ship of Harkinian" />
                                </StackPanel>
                            </UniformGrid>
                            <StackPanel Classes="field">
                                <TextBlock Classes="fieldLabel" Text="Título por expresión regular (opcional)" />
                                <TextBox Classes="mono" Text="{Binding WindowRegex}" />
                            </StackPanel>
                            <Border Classes="callout">
                                <TextBlock Classes="caption" Foreground="{DynamicResource TextBrush}"
                                           Text="Antes de pulsar, HiveShock trae el juego al frente y, al terminar, te devuelve a la ventana que estabas usando. Si el juego se ejecuta como administrador, HiveShock también debe ejecutarse así." />
                            </Border>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
