<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="using:HiveShock.Avalonia.ViewModels"
                    xmlns:ctl="using:HiveShock.Avalonia.Views.Controls">
    <!--
        Plantillas compartidas por los editores de regalos, comandos, metas, bits y eventos.
        Así un «efecto adicional» se ve y se usa igual en toda la app.
    -->

    <!-- Parámetros de un efecto, en fila (se parten en varias líneas si no caben). -->
    <ItemsPanelTemplate x:Key="ParamFieldsPanel">
        <WrapPanel ItemSpacing="12" LineSpacing="8" />
    </ItemsPanelTemplate>

    <DataTemplate x:Key="ParamFieldTemplate" x:DataType="vm:EffectParamFieldViewModel">
        <StackPanel Spacing="6" MinWidth="120">
            <TextBlock Classes="fieldLabel" Margin="0" Text="{Binding Label}" />
            <TextBox Text="{Binding ValueText}" Width="170" HorizontalAlignment="Left"
                     PlaceholderText="{Binding Hint}" />
        </StackPanel>
    </DataTemplate>

    <!-- Un efecto adicional: [⠿] [efecto ▾] [⏱ espera s] [🗑], y debajo sus parámetros. El asa reordena arrastrando. -->
    <DataTemplate x:Key="StepRowTemplate" x:DataType="vm:GiftStepRowViewModel">
        <Border Classes="inset" Padding="10" Margin="0,0,0,6">
            <StackPanel Spacing="10">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <Border Grid.Column="0" Classes="dragHandle" ctl:ListGestures.IsDragHandle="True"
                            ToolTip.Tip="Arrastra para cambiar el orden">
                        <ctl:Icon Data="{StaticResource Icon.Grip}" Size="16" StrokeThickness="3.2"
                                  Foreground="{DynamicResource FaintBrush}" />
                    </Border>
                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                              ItemsSource="{Binding EffectChoices}"
                              SelectedValue="{Binding Effect}"
                              SelectedValueBinding="{Binding Id}"
                              DisplayMemberBinding="{Binding Display}" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="10,0,6,0"
                                VerticalAlignment="Center"
                                ToolTip.Tip="Segundos desde el efecto anterior (0 = enseguida, hasta 30).">
                        <ctl:Icon Data="{StaticResource Icon.Clock}" Size="16" Foreground="{DynamicResource MutedBrush}"
                                  VerticalAlignment="Center" />
                        <TextBox Text="{Binding DelayText}" Width="56" PlaceholderText="0"
                                 HorizontalContentAlignment="Center" />
                        <TextBlock Text="s" Classes="caption" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Grid.Column="3" Classes="icon" Command="{Binding RemoveCommand}"
                            ToolTip.Tip="Quitar este efecto">
                        <ctl:Icon Data="{StaticResource Icon.Trash}" Size="16" />
                    </Button>
                </Grid>
                <ItemsControl ItemsSource="{Binding ParamFields}" IsVisible="{Binding HasParams}"
                              ItemsPanel="{StaticResource ParamFieldsPanel}"
                              ItemTemplate="{StaticResource ParamFieldTemplate}" />
            </StackPanel>
        </Border>
    </DataTemplate>
</ResourceDictionary>
