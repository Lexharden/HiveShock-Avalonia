<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HiveShock.Avalonia.ViewModels"
             xmlns:live="using:HiveShock.Live"
             xmlns:ctl="using:HiveShock.Avalonia.Views.Controls"
             xmlns:conv="using:HiveShock.Avalonia.Converters"
             x:Class="HiveShock.Avalonia.Views.Pages.DiagnosticPage"
             x:DataType="vm:DiagnosticViewModel">
    <!--
        Monitor de eventos crudos (solo builds de depuración), como un visor de registros:
        barra de filtros fija, métricas en una franja y tabla virtualizada de eventos.
    -->
    <UserControl.Styles>
        <Style Selector="TextBlock.cell">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <!-- Filas compactas: es un registro, no una lista de edición. -->
        <Style Selector="ListBox.log ListBoxItem">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
    </UserControl.Styles>

    <Border Classes="panel">
        <DockPanel>
            <!-- ================= Barra de filtros -->
            <Border DockPanel.Dock="Top" Classes="paneHeader" Padding="12,10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Classes="bar" Spacing="4" Margin="12,0,0,0">
                        <Button Classes="icon" Command="{Binding TogglePauseCommand}"
                                ToolTip.Tip="{Binding PauseLabel, StringFormat='{}{0} la captura en vivo'}">
                            <Panel>
                                <ctl:Icon Data="{StaticResource Icon.Pause}" IsVisible="{Binding !IsPaused}" />
                                <ctl:Icon Data="{StaticResource Icon.Play}" IsVisible="{Binding IsPaused}" />
                            </Panel>
                        </Button>
                        <Button Classes="icon" Command="{Binding ClearCommand}" ToolTip.Tip="Borrar los eventos acumulados">
                            <ctl:Icon Data="{StaticResource Icon.Trash}" />
                        </Button>
                        <Button Classes="secondary" Margin="4,0,0,0" Command="{Binding ExportCommand}"
                                ToolTip.Tip="Guarda el informe completo (TSV) en el Escritorio">
                            <StackPanel Classes="btnContent">
                                <ctl:Icon Data="{StaticResource Icon.Upload}" />
                                <TextBlock Text="Exportar TSV" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <Grid ColumnDefinitions="Auto,*">
                        <ComboBox Grid.Column="0" Width="150" Margin="0,0,10,0"
                                  ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding FilterCategory}"
                                  ToolTip.Tip="Filtrar por categoría" />
                        <TextBox Grid.Column="1" Classes="search" MaxWidth="420" HorizontalAlignment="Stretch"
                                 Padding="34,0,10,0" Text="{Binding FilterText}"
                                 PlaceholderText="Buscar por regalo, usuario, id, tipo…" />
                    </Grid>
                </DockPanel>
            </Border>

            <!-- ================= Métricas -->
            <Border DockPanel.Dock="Top" Padding="14,8" Background="{DynamicResource CardAltBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0">
                        <Border Classes="pill gold" IsVisible="{Binding IsPaused}">
                            <TextBlock Text="EN PAUSA" />
                        </Border>
                        <Border Classes="pill" IsVisible="{Binding !!DroppedCount}"
                                ToolTip.Tip="Eventos descartados porque la lista llegó a su límite.">
                            <TextBlock Text="{Binding DroppedCount, StringFormat='{}{0} descartados'}" />
                        </Border>
                        <Border Classes="pill">
                            <TextBlock Text="{Binding Events.Count, StringFormat='{}{0} en la lista'}" />
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ctl:Icon Data="{StaticResource Icon.Activity}" Size="14" Foreground="{DynamicResource FaintBrush}"
                                  VerticalAlignment="Center" />
                        <TextBlock Classes="mono" FontSize="11" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"
                                   Text="{Binding StatsText}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ================= Cabecera de columnas -->
            <Border DockPanel.Dock="Top" Padding="16,6,22,6"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="18,96,72,220,*">
                    <TextBlock Grid.Column="1" Classes="overline" Text="HORA" />
                    <TextBlock Grid.Column="2" Classes="overline" Text="ORIGEN" />
                    <TextBlock Grid.Column="3" Classes="overline" Text="TIPO" />
                    <TextBlock Grid.Column="4" Classes="overline" Text="RESUMEN" />
                </Grid>
            </Border>

            <!-- ================= Eventos -->
            <Panel>
                <ListBox Classes="plain log" ItemsSource="{Binding Events}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="live:DiagnosticEvent">
                            <Grid ColumnDefinitions="18,96,72,220,*" RowDefinitions="Auto,Auto"
                                  ToolTip.Tip="{Binding Category}">
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center" HorizontalAlignment="Left"
                                         Fill="{Binding Status, Converter={x:Static conv:DiagnosticStatusBrushConverter.Instance}}" />
                                <TextBlock Grid.Column="1" Classes="cell mono" FontSize="11"
                                           Foreground="{DynamicResource MutedBrush}"
                                           Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss.fff}'}" />
                                <Border Grid.Column="2" Classes="pill" Padding="6,1" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Source}" FontSize="10" />
                                </Border>
                                <TextBlock Grid.Column="3" Classes="cell mono" FontSize="11" FontWeight="SemiBold"
                                           Margin="0,0,12,0" Foreground="{DynamicResource GoldTextBrush}"
                                           Text="{Binding RawType}" ToolTip.Tip="{Binding RawType}" />
                                <TextBlock Grid.Column="4" Classes="cell" Text="{Binding Summary}" />
                                <TextBlock Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2" Classes="mono"
                                           FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource MutedBrush}"
                                           IsVisible="{Binding Detail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                           Text="{Binding Detail}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Classes="empty" IsVisible="{Binding !Events.Count}">
                    <ctl:Icon Data="{StaticResource Icon.Bug}" />
                    <TextBlock Classes="h2" Text="Sin eventos" />
                    <TextBlock Classes="caption"
                               Text="Conecta a un live: aquí aparecerán los eventos crudos de TikTok y Twitch tal como llegan." />
                </StackPanel>
            </Panel>
        </DockPanel>
    </Border>
</UserControl>
