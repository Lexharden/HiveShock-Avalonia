<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HiveShock.Avalonia.ViewModels"
        x:Class="HiveShock.Avalonia.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="HiveShock"
        Width="1180" Height="760"
        MinWidth="880" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}"
        Icon="/Assets/app.ico"
        Closing="Window_Closing">
    <Grid RowDefinitions="56,*">
        <Border Grid.Row="0"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel Margin="10,0,18,0">
                <Button DockPanel.Dock="Left" Classes="menu" Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Command="{Binding ToggleNavCommand}"
                        ToolTip.Tip="{Binding NavToggleTip}">
                    <TextBlock Text="☰" FontSize="18" HorizontalAlignment="Center" />
                </Button>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="8" ClipToBounds="True" Margin="0,0,10,0"
                            Background="{DynamicResource CardAltBrush}"
                            BorderBrush="{DynamicResource BrandGoldBrush}" BorderThickness="1">
                        <Image Source="{DynamicResource BrandLogo}" Stretch="Uniform" />
                    </Border>
                    <TextBlock Text="HiveShock" FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource BrandGoldBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="Lo que pasa en tu live llega al juego"
                               Foreground="{DynamicResource MutedBrush}" Margin="12,2,0,0"
                               FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="12">
                    <ComboBox Width="150"
                              ItemsSource="{Binding ThemeOptions}"
                              SelectedItem="{Binding SelectedTheme}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ThemeOption">
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Border CornerRadius="10" Padding="12,7" MinWidth="120"
                            Background="{DynamicResource CardAltBrush}"
                            Classes.connecting="{Binding IsToneConnecting}"
                            Classes.ok="{Binding IsToneOk}"
                            Classes.live="{Binding IsToneLive}">
                        <Border.Styles>
                            <Style Selector="Border.connecting">
                                <Setter Property="Background" Value="{DynamicResource BrandGoldBrush}" />
                            </Style>
                            <Style Selector="Border.ok">
                                <Setter Property="Background" Value="{DynamicResource StatusOkBrush}" />
                            </Style>
                            <Style Selector="Border.live">
                                <Setter Property="Background" Value="{DynamicResource LiveBrush}" />
                            </Style>
                        </Border.Styles>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                            <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                                     IsVisible="{Binding StatusDotVisible}"
                                     Classes.on="{Binding StatusOn}"
                                     Classes.live="{Binding IsToneLive}"
                                     Classes.pulse="{Binding IsToneLive}">
                                <Ellipse.Styles>
                                    <Style Selector="Ellipse.on">
                                        <Setter Property="Fill" Value="{DynamicResource StatusOnForegroundBrush}" />
                                    </Style>
                                    <Style Selector="Ellipse.on.live">
                                        <Setter Property="Fill" Value="{DynamicResource LiveOnForegroundBrush}" />
                                    </Style>
                                    <Style Selector="Ellipse.pulse">
                                        <Style.Animations>
                                            <Animation Duration="0:0:1.2" IterationCount="Infinite"
                                                       PlaybackDirection="Alternate">
                                                <KeyFrame Cue="0%">
                                                    <Setter Property="Opacity" Value="1" />
                                                </KeyFrame>
                                                <KeyFrame Cue="100%">
                                                    <Setter Property="Opacity" Value="0.55" />
                                                </KeyFrame>
                                            </Animation>
                                        </Style.Animations>
                                    </Style>
                                </Ellipse.Styles>
                            </Ellipse>
                            <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" FontSize="12"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextBrush}"
                                       Classes.on="{Binding StatusOn}"
                                       Classes.live="{Binding IsToneLive}">
                                <TextBlock.Styles>
                                    <Style Selector="TextBlock.on">
                                        <Setter Property="Foreground" Value="{DynamicResource StatusOnForegroundBrush}" />
                                    </Style>
                                    <Style Selector="TextBlock.on.live">
                                        <Setter Property="Foreground" Value="{DynamicResource LiveOnForegroundBrush}" />
                                    </Style>
                                </TextBlock.Styles>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*">
            <Border Width="{Binding SidebarWidth}"
                    MinWidth="{Binding SidebarWidth}"
                    MaxWidth="{Binding SidebarWidth}"
                    ClipToBounds="True"
                    Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <DockPanel Margin="0,8,0,8">
                    <Border DockPanel.Dock="Top" Margin="10,0,10,12" Padding="10"
                            Background="{DynamicResource CardAltBrush}" CornerRadius="10"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            IsVisible="{Binding NavExpanded}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="40" Height="40" CornerRadius="8" ClipToBounds="True"
                                    Background="{DynamicResource BgBrush}"
                                    BorderBrush="{DynamicResource BrandGoldBrush}" BorderThickness="1">
                                <Image Source="{DynamicResource BrandLogo}" Stretch="Uniform" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="HiveShock" FontWeight="SemiBold" FontSize="13"
                                           Foreground="{DynamicResource BrandGoldBrush}" />
                                <TextBlock Text="por Yafel" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <StackPanel DockPanel.Dock="Bottom">
                        <TextBlock Classes="navGroup" Text="INFO" IsVisible="{Binding NavExpanded}" />
                        <Button Classes="nav" Classes.active="{Binding IsHelpNav}"
                                Classes.compact="{Binding NavCollapsed}"
                                Command="{Binding NavHelpCommand}" ToolTip.Tip="Ayuda">
                            <Panel>
                                <TextBlock Text="?" HorizontalAlignment="Center"
                                           IsVisible="{Binding NavCollapsed}" />
                                <TextBlock Text="Ayuda" IsVisible="{Binding NavExpanded}" />
                            </Panel>
                        </Button>
                        <Button Classes="nav" Classes.active="{Binding IsAboutNav}"
                                Classes.compact="{Binding NavCollapsed}"
                                Command="{Binding NavAboutCommand}" ToolTip.Tip="Acerca de">
                            <Panel>
                                <TextBlock Text="i" HorizontalAlignment="Center"
                                           IsVisible="{Binding NavCollapsed}" />
                                <TextBlock Text="Acerca de" IsVisible="{Binding NavExpanded}" />
                            </Panel>
                        </Button>
                    </StackPanel>
                    <StackPanel>
                        <Button Classes="nav" Classes.active="{Binding IsStudioNav}"
                                Classes.compact="{Binding NavCollapsed}"
                                Command="{Binding NavStudioCommand}" ToolTip.Tip="Inicio">
                            <Panel>
                                <TextBlock Text="In" HorizontalAlignment="Center"
                                           IsVisible="{Binding NavCollapsed}" />
                                <TextBlock Text="Inicio" IsVisible="{Binding NavExpanded}" />
                            </Panel>
                        </Button>
                        <Button Classes="nav" Classes.active="{Binding IsTikTokNav}"
                                Classes.compact="{Binding NavCollapsed}"
                                Command="{Binding NavTikTokCommand}" ToolTip.Tip="TikTok">
                            <Panel>
                                <TextBlock Text="Tk" HorizontalAlignment="Center"
                                           IsVisible="{Binding NavCollapsed}" />
                                <TextBlock Text="TikTok" IsVisible="{Binding NavExpanded}" />
                            </Panel>
                        </Button>
                        <Button Classes="nav" Classes.active="{Binding IsTwitchNav}"
                                Classes.compact="{Binding NavCollapsed}"
                                Command="{Binding NavTwitchCommand}" ToolTip.Tip="Twitch">
                            <Panel>
                                <TextBlock Text="Tw" HorizontalAlignment="Center"
                                           IsVisible="{Binding NavCollapsed}" />
                                <TextBlock Text="Twitch" IsVisible="{Binding NavExpanded}" />
                            </Panel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1" RowDefinitions="*,8,160">
                <ContentControl Content="{Binding CurrentPage}" Margin="14,10,14,8"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch"
                              ResizeDirection="Rows" />
                <Border Grid.Row="2"
                        MinHeight="72"
                        Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,1,0,0" Padding="14,8">
                    <Expander Header="Qué está pasando" IsExpanded="True"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch">
                        <Grid RowDefinitions="*,Auto" Margin="0,8,0,0">
                            <TextBox Text="{Binding ActivityText, Mode=OneWay}" IsReadOnly="True"
                                     TextWrapping="Wrap" AcceptsReturn="True"
                                     HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     BorderThickness="0" Background="{DynamicResource BgBrush}" />
                            <Expander Grid.Row="1" Header="Más detalle" IsExpanded="{Binding DetailLogOpen}"
                                      Margin="0,8,0,0"
                                      HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Stretch">
                                <TextBox MinHeight="90" MaxHeight="200"
                                         Text="{Binding DetailLogText, Mode=OneWay}" IsReadOnly="True"
                                         FontFamily="Cascadia Mono, Consolas, monospace" FontSize="11"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         HorizontalAlignment="Stretch"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         BorderThickness="0" Background="{DynamicResource BgBrush}" Margin="0,8,0,0" />
                            </Expander>
                        </Grid>
                    </Expander>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
