<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="using:HiveShock.Avalonia.Views.Controls"
        xmlns:chrome="using:Avalonia.Controls.Chrome">
    <!--
        Sistema de diseño de HiveShock (rama new-ui).

        Escala de espaciado: 4 · 8 · 12 · 16 · 24 · 32.   Radios: 6 (controles) · 8 (filas) · 10 (paneles).
        Tipografía: h1 20 · h2 15 · cuerpo 13 · caption 12 · overline 11 (mayúsculas, espaciado).
        Colores: tokens *Brush que pone Themes/ThemeManager.cs (claro/oscuro).

        Clases nuevas (vistas rediseñadas): h1, h2, body, caption, overline, ghost, icon, accent-soft,
        panel, section, toolbar, field, pill, kbd.  Las clases antiguas (pageTitle, card, primary,
        secondary…) se mantienen con el nuevo aspecto para las vistas que aún no se han migrado.
    -->

    <!-- ===================================================== Ventana -->
    <!-- La barra de título es propia (MainWindow): se oculta el título que dibuja Avalonia encima. -->
    <Style Selector="chrome|WindowDrawnDecorations">
        <Setter Property="Title" Value="" />
    </Style>
    <Style Selector=":is(Control)#PART_TitleTextPanel">
        <Setter Property="IsVisible" Value="False" />
        <Setter Property="Opacity" Value="0" />
    </Style>
    <!-- Avalonia 12 añade un cuarto botón (pantalla completa) junto a minimizar/maximizar/cerrar: se tapaba con
         los botones de la barra propia y una app de directo no lo necesita (maximizar ya cubre la pantalla). -->
    <Style Selector=":is(Control)#PART_FullScreenButton, :is(Control)#PART_PopoverFullScreenButton">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- Ventanas secundarias (diálogos). La principal y los overlays fijan su propio fondo. -->
    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>

    <!-- ===================================================== Tipografía -->
    <Style Selector="TextBlock.h1">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="TextBlock.h2">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="TextBlock.body">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="TextBlock.caption">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    </Style>
    <Style Selector="TextBlock.overline">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LetterSpacing" Value="0.6" />
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    </Style>
    <Style Selector="TextBlock.accent">
        <Setter Property="Foreground" Value="{DynamicResource GoldTextBrush}" />
    </Style>

    <!-- Antiguas: mismo aspecto que la escala nueva. -->
    <Style Selector="TextBlock.pageTitle">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style Selector="TextBlock.pageLead">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,20" />
    </Style>
    <Style Selector="TextBlock.sectionTitle">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LetterSpacing" Value="0.6" />
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style Selector="TextBlock.fieldLabel">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style Selector="TextBlock.helpBody">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style Selector="TextBlock.helpBullet">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Margin" Value="12,0,0,6" />
    </Style>
    <Style Selector="TextBlock.mono">
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Menlo, monospace" />
    </Style>
    <Style Selector="TextBox.mono">
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Menlo, monospace" />
    </Style>

    <!-- ===================================================== Superficies -->
    <!-- panel: contenedor con borde, sin padding (listas, editores con cabecera propia). -->
    <Style Selector="Border.panel">
        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <!-- section / card: bloque de ajustes con padding. -->
    <Style Selector="Border.section, Border.card">
        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="16" />
    </Style>
    <!-- inset: bloque anidado dentro de una sección (pasos extra, vista previa). -->
    <Style Selector="Border.inset">
        <Setter Property="Background" Value="{DynamicResource CardAltBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12" />
    </Style>
    <!-- Cabecera / pie de un panel: separada por una línea. -->
    <Style Selector="Border.paneHeader">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="MinHeight" Value="48" />
    </Style>
    <Style Selector="Border.paneFooter">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="12,8" />
    </Style>
    <!-- Aviso: info (acento), warn (oro), danger. -->
    <Style Selector="Border.callout">
        <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,10" />
    </Style>
    <Style Selector="Border.callout.warn">
        <Setter Property="Background" Value="{DynamicResource GoldSubtleBrush}" />
    </Style>
    <Style Selector="Border.callout.danger">
        <Setter Property="Background" Value="{DynamicResource DangerSubtleBrush}" />
    </Style>
    <!-- Píldora de estado pequeña. -->
    <Style Selector="Border.pill">
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="Background" Value="{DynamicResource CardAltBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.pill > TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    </Style>
    <Style Selector="Border.pill.gold">
        <Setter Property="Background" Value="{DynamicResource GoldSubtleBrush}" />
    </Style>
    <Style Selector="Border.pill.gold > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource GoldTextBrush}" />
    </Style>
    <Style Selector="Border.pill.ok">
        <Setter Property="Background" Value="{DynamicResource OkSubtleBrush}" />
    </Style>
    <Style Selector="Border.pill.ok > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource StatusOkBrush}" />
    </Style>
    <!-- Separador fino. -->
    <Style Selector="Border.divider">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
        <Setter Property="Margin" Value="0,12" />
    </Style>
    <!--
        Fila de formulario de dos columnas. Dentro de un contenedor «editor» estrecho (p. ej. con el panel de
        actividad abierto) pasa a una columna: ContainerQuery de Avalonia, como las container queries de CSS.
    -->
    <Style Selector="UniformGrid.formRow">
        <Setter Property="Columns" Value="2" />
        <Setter Property="ColumnSpacing" Value="16" />
    </Style>
    <ContainerQuery Name="editor" Query="max-width:620">
        <Style Selector="UniformGrid.formRow">
            <Setter Property="Columns" Value="1" />
        </Style>
        <Style Selector=":is(Control).wideOnly">
            <Setter Property="IsVisible" Value="False" />
        </Style>
    </ContainerQuery>

    <!-- Grupo de campo: etiqueta + control, con aire debajo. -->
    <Style Selector="StackPanel.field">
        <Setter Property="Spacing" Value="6" />
        <Setter Property="Margin" Value="0,0,0,14" />
    </Style>
    <Style Selector="StackPanel.field > TextBlock.fieldLabel">
        <Setter Property="Margin" Value="0" />
    </Style>

    <!-- ===================================================== Botones -->
    <Style Selector="Button, ToggleButton, DropDownButton, SplitButton">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}" />
    </Style>

    <!-- secondary (por defecto en barras): superficie con borde. -->
    <Style Selector="Button.secondary">
        <Setter Property="Background" Value="{DynamicResource CardAltBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Margin" Value="0,0,8,8" />
    </Style>
    <Style Selector="Button.secondary:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PressedBrush}" />
    </Style>

    <!-- primary: acción principal de la vista (una por zona). -->
    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,8,8" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
    </Style>

    <!-- danger: acciones destructivas. -->
    <Style Selector="Button.danger">
        <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,8,8" />
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource DangerHoverBrush}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- ghost: sin fondo hasta el hover (acciones terciarias, barras de herramientas). -->
    <Style Selector="Button.ghost, ToggleButton.ghost, DropDownButton.ghost">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="MinHeight" Value="32" />
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter, DropDownButton.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>
    <Style Selector="Button.ghost.dangerText">
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    </Style>
    <Style Selector="Button.ghost.dangerText:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource DangerSubtleBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    </Style>

    <!-- icon: botón cuadrado solo con icono (lleva ToolTip siempre). -->
    <Style Selector="Button.icon, ToggleButton.icon">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="ToggleButton.icon:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    </Style>

    <!-- Botón con icono + texto: <StackPanel Classes="btnContent"> [Icon] [TextBlock] -->
    <Style Selector="StackPanel.btnContent">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Spacing" Value="6" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="StackPanel.btnContent > ctl|Icon">
        <Setter Property="Size" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="StackPanel.btnContent > TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Barras: dentro de StackPanel.bar los botones no llevan margen propio (usa Spacing). -->
    <Style Selector="StackPanel.bar">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Spacing" Value="6" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="StackPanel.bar > Button, StackPanel.bar > DropDownButton, StackPanel.bar > SplitButton, StackPanel.bar > ToggleButton">
        <Setter Property="Margin" Value="0" />
    </Style>

    <Style Selector="Button.kofi">
        <Setter Property="Background" Value="{DynamicResource BrandGoldBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource StatusOnForegroundBrush}" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,4,8,8" />
    </Style>

    <!-- Botón grande de conectar (Inicio y barra lateral). -->
    <Style Selector="Button.connect">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
        <Setter Property="Padding" Value="20,12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style Selector="Button.connect:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
    </Style>
    <Style Selector="Button.connect.connecting">
        <Setter Property="Background" Value="{DynamicResource BrandGoldBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource StatusOnForegroundBrush}" />
    </Style>
    <Style Selector="Button.connect.connecting:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrandGoldBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource StatusOnForegroundBrush}" />
    </Style>
    <Style Selector="Button.connect.live">
        <Setter Property="Background" Value="{DynamicResource LiveBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource LiveOnForegroundBrush}" />
    </Style>
    <Style Selector="Button.connect.live:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource LiveBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource LiveOnForegroundBrush}" />
    </Style>
    <Style Selector="Button.connect.ok">
        <Setter Property="Background" Value="{DynamicResource StatusOkBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource StatusOnForegroundBrush}" />
    </Style>
    <Style Selector="Button.connect.ok:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource StatusOkBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource StatusOnForegroundBrush}" />
    </Style>

    <!-- Tono de texto de estado (conectando / en vivo / ok / error) sobre el fondo normal. -->
    <Style Selector="TextBlock.tone-connecting">
        <Setter Property="Foreground" Value="{DynamicResource GoldTextBrush}" />
    </Style>
    <Style Selector="TextBlock.tone-live">
        <Setter Property="Foreground" Value="{DynamicResource LiveTextBrush}" />
    </Style>
    <Style Selector="TextBlock.tone-ok">
        <Setter Property="Foreground" Value="{DynamicResource StatusOkBrush}" />
    </Style>
    <Style Selector="TextBlock.tone-error">
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    </Style>

    <!-- Chips de opción (modo, contador, alineación). -->
    <Style Selector="RadioButton.chip">
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Background" Value="{DynamicResource CardAltBrush}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="RadioButton.chip:checked">
        <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- seg: opción de un control segmentado (sin círculo de radio, centrada, ocupa su celda). -->
    <Style Selector="RadioButton.chip.seg">
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Padding" Value="6,6" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.chip.seg:pointerover">
        <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>
    <Style Selector="RadioButton.chip.seg:checked">
        <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
    </Style>

    <Style Selector="Button.swatch">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}" />
    </Style>
    <Style Selector="Button.swatch.selected">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentTextBrush}" />
        <Setter Property="BorderThickness" Value="3" />
    </Style>

    <!-- Tarjeta de juego (Inicio). -->
    <Style Selector="Button.gamecard">
        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="Margin" Value="0,0,10,10" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="Width" Value="236" />
        <Setter Property="MinHeight" Value="84" />
    </Style>
    <Style Selector="Button.gamecard.active">
        <Setter Property="BorderBrush" Value="{DynamicResource BrandGoldBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Background" Value="{DynamicResource GoldSubtleBrush}" />
    </Style>
    <Style Selector="Button.gamecard.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource GoldSubtleBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrandGoldBrush}" />
    </Style>

    <!-- ===================================================== Navegación lateral -->
    <Style Selector="TextBlock.navGroup">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LetterSpacing" Value="0.6" />
        <Setter Property="Foreground" Value="{DynamicResource FaintBrush}" />
        <Setter Property="Margin" Value="20,16,16,6" />
    </Style>
    <Style Selector="Button.nav">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Margin" Value="8,1" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="Button.nav.active">
        <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.nav.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
    </Style>
    <!-- Indicador vertical de la página activa. -->
    <Style Selector="Button.nav Border.navIndicator">
        <Setter Property="Width" Value="3" />
        <Setter Property="Height" Value="16" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.nav.active Border.navIndicator">
        <Setter Property="Background" Value="{DynamicResource BrandGoldBrush}" />
    </Style>
    <Style Selector="Button.nav.active ctl|Icon">
        <Setter Property="Foreground" Value="{DynamicResource GoldTextBrush}" />
    </Style>
    <Style Selector="Button.menu">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.menu:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>

    <!-- ===================================================== Pestañas -->
    <!-- Pestañas compactas tipo «segmento subrayado»: las de Fluent miden ~48px y letra de 20. -->
    <Style Selector="TabControl">
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="TabItem">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Margin" Value="0,0,2,0" />
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="TabItem:pointerover /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="TabItem:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="TabItem:selected">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TabItem:selected /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="TabItem /template/ Border#PART_SelectedPipe">
        <Setter Property="Background" Value="{DynamicResource BrandGoldBrush}" />
        <Setter Property="Height" Value="2" />
        <Setter Property="CornerRadius" Value="1" />
        <Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector="TabItem:pointerover /template/ ContentPresenter#PART_ContentPresenter, TabItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <!-- Contenido de pestaña con icono: <StackPanel Classes="tabHeader"> [Icon] [TextBlock] -->
    <Style Selector="StackPanel.tabHeader">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Spacing" Value="7" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="StackPanel.tabHeader > ctl|Icon">
        <Setter Property="Size" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="StackPanel.tabHeader > TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ===================================================== Listas -->
    <Style Selector="ListBox">
        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="4" />
    </Style>
    <!-- plain: lista dentro de un Border.panel (sin marco propio). -->
    <Style Selector="ListBox.plain">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="6" />
    </Style>
    <Style Selector="ListBoxItem">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Margin" Value="0,1" />
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
    </Style>
    <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
    </Style>
    <Style Selector="ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
    </Style>

    <!-- ===================================================== Entradas -->
    <Style Selector="TextBox">
        <Setter Property="Background" Value="{DynamicResource InputBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource InputBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}" />
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource InputBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="TextBox:focus">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="TextBox.search">
        <Setter Property="InnerLeftContent">
            <Template>
                <ctl:Icon Data="{StaticResource Icon.Search}" Size="16" Margin="10,0,0,0"
                          Foreground="{DynamicResource FaintBrush}" />
            </Template>
        </Setter>
    </Style>
    <Style Selector="ComboBox">
        <Setter Property="Background" Value="{DynamicResource InputBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="MaxDropDownHeight" Value="320" />
    </Style>
    <Style Selector="ComboBox:pointerover /template/ Border#Background">
        <Setter Property="Background" Value="{DynamicResource InputBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}" />
    </Style>
    <Style Selector="NumericUpDown">
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <!-- ===================================================== Otros -->
    <Style Selector="Expander">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Expander /template/ ContentPresenter">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Expander.account">
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <Style Selector="GridSplitter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="MinWidth" Value="6" />
        <Setter Property="MinHeight" Value="6" />
    </Style>
    <Style Selector="GridSplitter:pointerover">
        <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
    </Style>
    <Style Selector="GridSplitter:pressed">
        <Setter Property="Background" Value="{DynamicResource BrandGoldBrush}" />
    </Style>

    <Style Selector="ToolTip">
        <Setter Property="Background" Value="{DynamicResource PopupBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MaxWidth" Value="360" />
    </Style>

    <Style Selector="ScrollViewer">
        <Setter Property="AllowAutoHide" Value="True" />
    </Style>

    <!-- Atajo de teclado pequeño (p. ej. «Ctrl+S»). -->
    <Style Selector="Border.kbd">
        <Setter Property="Background" Value="{DynamicResource CardAltBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="5,1" />
    </Style>
    <Style Selector="Border.kbd > TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    </Style>

    <!-- Estado vacío de un panel. -->
    <Style Selector="StackPanel.empty">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Spacing" Value="8" />
        <Setter Property="MaxWidth" Value="320" />
    </Style>
    <Style Selector="StackPanel.empty > ctl|Icon">
        <Setter Property="Size" Value="32" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="Foreground" Value="{DynamicResource FaintBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="StackPanel.empty > TextBlock">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>
</Styles>
