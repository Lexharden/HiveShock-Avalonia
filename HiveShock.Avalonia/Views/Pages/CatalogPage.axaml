<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HiveShock.Avalonia.ViewModels"
             xmlns:cfg="using:HiveShock.Configuration"
             xmlns:conv="using:HiveShock.Avalonia.Converters"
             xmlns:ctl="using:HiveShock.Avalonia.Views.Controls"
             x:Class="HiveShock.Avalonia.Views.Pages.CatalogPage"
             x:DataType="vm:CatalogViewModel">
    <!-- Tabla de regalos de TikTok: buscador + filtro arriba, columnas fijas y la acción principal a la derecha. -->
    <Border Classes="panel">
        <DockPanel>
            <!-- Barra de herramientas -->
            <Border DockPanel.Dock="Top" Classes="paneHeader" Padding="12,10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Classes="bar" Spacing="4" Margin="12,0,0,0">
                        <Button Classes="icon" Command="{Binding EditCommand}" ToolTip.Tip="Editar el regalo seleccionado">
                            <ctl:Icon Data="{StaticResource Icon.Sliders}" />
                        </Button>
                        <Button Classes="icon" ToolTip.Tip="Más acciones">
                            <ctl:Icon Data="{StaticResource Icon.More}" />
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <MenuItem Header="Añadir un regalo a mano…" Command="{Binding NewItemCommand}">
                                        <MenuItem.Icon>
                                            <ctl:Icon Data="{StaticResource Icon.Plus}" Size="16" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Recargar" Command="{Binding ReloadCommand}">
                                        <MenuItem.Icon>
                                            <ctl:Icon Data="{StaticResource Icon.Refresh}" Size="16" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Abrir carpeta del catálogo" Command="{Binding OpenFolderCommand}">
                                        <MenuItem.Icon>
                                            <ctl:Icon Data="{StaticResource Icon.Folder}" Size="16" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                        <Button Classes="primary" Margin="4,0,0,0" Command="{Binding AddToGiftsCommand}"
                                ToolTip.Tip="Añade el regalo seleccionado a la lista de Regalos de este juego (también con doble clic).">
                            <StackPanel Classes="btnContent">
                                <ctl:Icon Data="{StaticResource Icon.Plus}" />
                                <TextBlock Text="Usar en este juego" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Classes="search" MaxWidth="340" HorizontalAlignment="Stretch" Text="{Binding SearchText}"
                                 PlaceholderText="Buscar por nombre o ID…" />
                        <CheckBox Grid.Column="1" Margin="12,0,0,0" Content="Todos los de TikTok"
                                  IsChecked="{Binding ShowAllTikTokGifts}" VerticalAlignment="Center"
                                  ToolTip.Tip="Marcado: todos los regalos de TikTok. Sin marcar: solo los que han llegado en tus directos." />
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Pie: resumen -->
            <Border DockPanel.Dock="Bottom" Classes="paneFooter" Padding="14,8">
                <TextBlock Classes="caption" Text="{Binding Summary}" />
            </Border>

            <!-- Cabecera de columnas -->
            <Border DockPanel.Dock="Top" Padding="22,8,26,8" Background="{DynamicResource CardAltBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="52,*,110,110">
                    <TextBlock Grid.Column="1" Classes="overline" Text="NOMBRE" />
                    <TextBlock Grid.Column="2" Classes="overline" Text="DIAMANTES" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="3" Classes="overline" Text="VECES VISTO" HorizontalAlignment="Right" />
                </Grid>
            </Border>

            <Panel>
                <!-- Doble clic o Intro: lo mismo que «Usar en este juego». -->
                <ListBox Classes="plain" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}"
                         ctl:ListGestures.ActivateCommand="{Binding AddToGiftsCommand}">
                    <ListBox.ContextFlyout>
                        <MenuFlyout>
                            <MenuItem Header="Usar en este juego" Command="{Binding AddToGiftsCommand}">
                                <MenuItem.Icon>
                                    <ctl:Icon Data="{StaticResource Icon.Plus}" Size="16" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Editar" Command="{Binding EditCommand}">
                                <MenuItem.Icon>
                                    <ctl:Icon Data="{StaticResource Icon.Sliders}" Size="16" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </MenuFlyout>
                    </ListBox.ContextFlyout>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="cfg:CatalogGift">
                            <Grid ColumnDefinitions="52,*,110,110" ToolTip.Tip="{Binding IdsText}">
                                <Border Width="36" Height="36" CornerRadius="8" ClipToBounds="True" HorizontalAlignment="Left"
                                        Background="{DynamicResource CardAltBrush}">
                                    <Image Width="32" Height="32" Stretch="Uniform"
                                           Source="{Binding Converter={x:Static conv:GiftImageConverter.Instance}}" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontWeight="SemiBold"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5" HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                    <ctl:Icon Data="{StaticResource Icon.Gem}" Size="13" Foreground="{DynamicResource AccentTextBrush}" />
                                    <TextBlock Text="{Binding Diamonds}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right"
                                           Text="{Binding Seen}" Foreground="{DynamicResource MutedBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Classes="empty" IsVisible="{Binding !Rows.Count}">
                    <ctl:Icon Data="{StaticResource Icon.Search}" />
                    <TextBlock Classes="h2" Text="No hay regalos que mostrar" />
                    <TextBlock Classes="caption" Text="Cambia la búsqueda o marca «Todos los de TikTok»." />
                </StackPanel>
            </Panel>
        </DockPanel>
    </Border>
</UserControl>
