<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HiveShock.Avalonia.ViewModels"
             x:Class="HiveShock.Avalonia.Views.Controls.SaveStatusChip"
             x:DataType="vm:SaveStatusViewModel">
    <!--
        Estado de guardado compacto: [✓ Auto]  ● Guardado
        Cabe en el pie de una lista estrecha; el mensaje completo va en el tooltip.
    -->
    <UserControl.Styles>
        <Style Selector="Ellipse.saveDot">
            <Setter Property="Width" Value="7" />
            <Setter Property="Height" Value="7" />
            <Setter Property="Fill" Value="{DynamicResource FaintBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Ellipse.saveDot.ok">
            <Setter Property="Fill" Value="{DynamicResource StatusOkBrush}" />
        </Style>
        <Style Selector="Ellipse.saveDot.err">
            <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
        </Style>
        <Style Selector="Ellipse.saveDot.pending">
            <Setter Property="Fill" Value="{DynamicResource BrandGoldBrush}" />
        </Style>
        <Style Selector="TextBlock.saveText">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="TextBlock.saveText.err">
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
        </Style>
    </UserControl.Styles>
    <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
        <CheckBox Grid.Column="0" Content="Auto" MinWidth="0" Margin="0,0,12,0"
                  IsChecked="{Binding AutoSaveEnabled}" IsVisible="{Binding SupportsAutoSave}"
                  VerticalAlignment="Center"
                  ToolTip.Tip="Guardado automático: los cambios se guardan solos al poco de hacerlos." />
        <Grid Grid.Column="1" ColumnDefinitions="Auto,*" IsVisible="{Binding IsVisible}"
              VerticalAlignment="Center" Background="Transparent" ToolTip.Tip="{Binding Message}">
            <Ellipse Classes="saveDot" Margin="0,0,6,0" Classes.ok="{Binding IsSaved}" Classes.err="{Binding IsFailed}"
                     Classes.pending="{Binding IsPending}" />
            <TextBlock Grid.Column="1" Classes="saveText" Classes.err="{Binding IsFailed}" Text="{Binding Message}"
                       MaxWidth="360" />
        </Grid>
    </Grid>
</UserControl>
