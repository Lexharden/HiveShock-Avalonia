<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HiveShock.Avalonia.ViewModels"
             xmlns:ctl="using:HiveShock.Avalonia.Views.Controls"
             x:Class="HiveShock.Avalonia.Views.Controls.StepListEditor"
             x:DataType="vm:StepListViewModel">
    <!-- Efectos adicionales («y después…»): mismo aspecto que en Regalos (Themes/Templates.axaml). -->
    <StackPanel Spacing="8">
        <DockPanel>
            <Button DockPanel.Dock="Right" Classes="ghost" Padding="8,4" MinHeight="28"
                    Command="{Binding AddCommand}">
                <StackPanel Classes="btnContent">
                    <ctl:Icon Data="{StaticResource Icon.Plus}" />
                    <TextBlock Text="Añadir efecto" />
                </StackPanel>
            </Button>
            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock Classes="fieldLabel" Margin="0" Text="Después, más efectos" />
                <TextBlock Classes="caption" FontSize="11" IsVisible="{Binding !HasSteps}"
                           Text="Opcional. Salen en orden, tras el principal." />
            </StackPanel>
        </DockPanel>
        <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource StepRowTemplate}"
                      ctl:ListGestures.ReorderFromHandle="True" />
    </StackPanel>
</UserControl>
