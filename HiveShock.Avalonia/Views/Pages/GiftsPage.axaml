<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HiveShock.Avalonia.ViewModels"
             x:Class="HiveShock.Avalonia.Views.Pages.GiftsPage"
             x:DataType="vm:GiftsViewModel">
    <Grid RowDefinitions="Auto,*">
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <WrapPanel>
                <Button Classes="secondary" Content="Nuevo" Command="{Binding NewGiftCommand}" />
                <Button Classes="secondary" Content="Elegir de los vistos" Command="{Binding FromCatalogCommand}" />
                <Button Classes="secondary" Content="Quitar" Command="{Binding DeleteGiftCommand}" />
                <Button Classes="secondary" Content="Recargar" Command="{Binding ReloadCommand}" />
                <Button Classes="secondary" Content="Abrir imágenes" Command="{Binding OpenImagesCommand}" />
                <Button Classes="primary" Content="Guardar" Command="{Binding SaveCommand}" />
            </WrapPanel>
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="280,12,*">
            <ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:GiftRowViewModel">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="8"
                                    ClipToBounds="True" Margin="0,0,10,0"
                                    Background="{DynamicResource CardAltBrush}">
                                <Image Width="36" Height="36" Stretch="Uniform" Source="{Binding Thumb}" />
                            </Border>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Note}" Foreground="{DynamicResource MutedBrush}"
                                           FontSize="12" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                          IsVisible="{Binding HasSelection}">
                <Border Classes="card">
                    <StackPanel>
                        <TextBlock Classes="fieldLabel" Text="Nombre del regalo" />
                        <TextBox Text="{Binding Selected.Name}" Margin="0,0,0,12" />

                        <TextBlock Classes="fieldLabel" Text="Qué hace en el juego" />
                        <ComboBox Margin="0,0,0,12"
                                  ItemsSource="{Binding EffectChoices}"
                                  SelectedValue="{Binding Selected.Effect}"
                                  SelectedValueBinding="{Binding Id}"
                                  DisplayMemberBinding="{Binding Display}" />

                        <TextBlock Classes="fieldLabel" Text="Nota (solo para ti)" />
                        <TextBox Text="{Binding Selected.Note}" Margin="0,0,0,12" />

                        <TextBlock Classes="fieldLabel" Text="Mínimo de regalos seguidos" />
                        <TextBox Text="{Binding Selected.MinCount}" Width="80"
                                 HorizontalAlignment="Left" Margin="0,0,0,8" />
                        <CheckBox Content="Repetir el efecto en cada uno"
                                  IsChecked="{Binding Selected.Each}" Margin="0,0,0,12" />

                        <CheckBox Content="Mostrar en pantalla" IsChecked="{Binding Selected.Overlay}" />
                        <TextBlock Classes="fieldLabel" Text="Texto en pantalla (vacío = el nombre)"
                                   Margin="0,8,0,6" />
                        <TextBox Text="{Binding Selected.OverlayText}" Margin="0,0,0,16" />

                        <Expander Header="Más opciones">
                            <StackPanel Margin="0,10,0,0">
                                <TextBlock Classes="fieldLabel" Text="ID en TikTok (opcional)" />
                                <TextBox Text="{Binding Selected.Id}" Margin="0,0,0,10" />
                                <TextBlock Classes="fieldLabel" Text="Diamantes" />
                                <TextBox Text="{Binding Selected.Diamonds}" Margin="0,0,0,10" />
                                <TextBlock Classes="fieldLabel" Text="Otros nombres, separados por coma" />
                                <TextBox Text="{Binding Selected.Also}" Margin="0,0,0,10" />
                                <TextBlock Classes="fieldLabel" Text="Nombre de la imagen" />
                                <TextBox Text="{Binding Selected.Image}" />
                            </StackPanel>
                        </Expander>

                        <DockPanel Margin="0,18,0,0">
                            <TextBlock Classes="fieldLabel" Text="Probar ×"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Text="{Binding TestComboText}" Width="56" Margin="0,0,12,0" />
                            <Button Classes="primary" Content="Enviar al juego"
                                    Command="{Binding TestCommand}" HorizontalAlignment="Left" />
                        </DockPanel>
                        <TextBlock Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                   Margin="0,8,0,0" TextWrapping="Wrap"
                                   Text="Prueba el efecto ahora, sin esperar un regalo. El juego tiene que estar abierto." />
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
